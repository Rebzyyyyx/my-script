        while true do
            task.wait(0.5)
            if panel.Visible then
                local list = collectUsers()
                local ids = {}
                for _, u in ipairs(list) do table.insert(ids, tostring(u.id) .. (u.creator and "c" or "")) end
                local signature = table.concat(ids, ",")
                if signature ~= lastSignature then
                    lastSignature = signature
                    rebuild(list)
                end
                header.Text = "Юзеры скрипта: " .. #list

                local myChar = LocalPlayer.Character
                local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
                for _, r in pairs(rows) do
                    if r.self then
                        r.distLabel.Text = "это ты"
                    else
                        local char = r.player.Character
                        local part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
                        if part and myRoot then
                            r.distLabel.Text = math.floor((part.Position - myRoot.Position).Magnitude + 0.5) .. " studs"
                        else
                            r.distLabel.Text = "-"
                        end
                    end
                end
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode ~= USERS_KEY then return end
        if HudKeyListening or Freecam.Listening or UserInputService:GetFocusedTextBox() then return end
        panel.Visible = not panel.Visible
        lastSignature = "" -- при открытии пересобираем список
    end)
end

