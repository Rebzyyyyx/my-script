-- УВЕДОМЛЕНИЕ ПРИ ЗАПУСКЕ (ЛАВА-ЛАМПА)
-- Капли поднимаются и опускаются, вытягиваются при движении
-- и "сливаются" перемычками, когда подходят близко друг к другу
-- ==========================================
-- GUI держим в защищённом контейнере (gethui / CoreGui): игра не может удалить его при смене
-- раунда/режима (раньше в DECAY через ~15 минут пропадали аимбот-худ и FOV-круг)
local function resolveGuiParent()
    local okHui, hui = pcall(function() return gethui and gethui() end)
    if okHui and hui then return hui end

    local okCore, core = pcall(function()
        local probe = Instance.new("Folder")
        probe.Parent = game:GetService("CoreGui")
        probe:Destroy()
        return game:GetService("CoreGui")
    end)
    if okCore and core then return core end

    return LocalPlayer:WaitForChild("PlayerGui")
end
local GuiParent = resolveGuiParent()

local function destroyOldGui(name)
    for _, container in ipairs({ GuiParent, LocalPlayer:FindFirstChild("PlayerGui") }) do
        if container then
            local old = container:FindFirstChild(name)
            if old then pcall(function() old:Destroy() end) end
        end
    end
end

local function showStartupNotification()
    if not Settings.ShowNotification then return end

    destroyOldGui("RebzyyxNotificationGui")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "RebzyyxNotificationGui"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = GuiParent

    local W, H = 310, 70

    local notifFrame = Instance.new("Frame")
    notifFrame.Name = "NotificationFrame"
    notifFrame.Size = UDim2.new(0, W, 0, H)
    notifFrame.Position = UDim2.new(1, 350, 0, 20)
    notifFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    notifFrame.BackgroundTransparency = 0
    notifFrame.BorderSizePixel = 0
    notifFrame.ClipsDescendants = true
    notifFrame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = notifFrame

    -- жидкость в лампе: тёмно-фиолетовая сверху, теплее к низу
    local liquidGradient = Instance.new("UIGradient")
    liquidGradient.Rotation = 90
    liquidGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 8, 48)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 12, 80)),
    })
    liquidGradient.Parent = notifFrame

    local lamp = Instance.new("Frame")
    lamp.Name = "LavaLamp"
    lamp.Size = UDim2.fromScale(1, 1)
    lamp.BackgroundTransparency = 1
    lamp.ClipsDescendants = true
    lamp.ZIndex = 1
    lamp.Parent = notifFrame

    local LavaColor = Color3.fromRGB(240, 70, 190)
    local GlowColor = Color3.fromRGB(255, 120, 220)

    local function makeCircle(parent, color, transparency, zIndex)
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = color
        f.BackgroundTransparency = transparency
        f.BorderSizePixel = 0
        f.ZIndex = zIndex
        f.Parent = parent
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = f
        return f
    end

    -- мягкое свечение под каплями
    local glowLayer = Instance.new("Frame")
    glowLayer.Name = "Glow"
    glowLayer.Size = UDim2.fromScale(1, 1)
    glowLayer.BackgroundTransparency = 1
    glowLayer.ZIndex = 1
    glowLayer.Parent = lamp

    local bodyLayer = Instance.new("Frame")
    bodyLayer.Name = "Body"
    bodyLayer.Size = UDim2.fromScale(1, 1)
    bodyLayer.BackgroundTransparency = 1
    bodyLayer.ZIndex = 2
    bodyLayer.Parent = lamp

    local rnd = Random.new(os.clock() * 1000)
    local blobs = {}
    local BLOB_COUNT = 7

    for i = 1, BLOB_COUNT do
        local r = rnd:NextNumber(11, 21)
        local blob = {
            r = r,
            xBase = (i - 0.5) / BLOB_COUNT * W + rnd:NextNumber(-12, 12),
            xAmp = rnd:NextNumber(10, 28),
            xSpeed = rnd:NextNumber(0.5, 1.1),
            ySpeed = rnd:NextNumber(0.9, 1.6),
            phaseX = rnd:NextNumber(0, math.pi * 2),
            phaseY = rnd:NextNumber(0, math.pi * 2),
            cx = 0,
            cy = 0,
        }
        blob.glow = makeCircle(glowLayer, GlowColor, 0.82, 1)
        blob.obj = makeCircle(bodyLayer, LavaColor, 0.05, 2)
        blobs[i] = blob
    end

    -- перемычки между всеми парами капель
    local necks = {}
    for i = 1, BLOB_COUNT do
        for j = i + 1, BLOB_COUNT do
            local neck = makeCircle(bodyLayer, LavaColor, 0.05, 2)
            neck.Visible = false
            table.insert(necks, { i = i, j = j, obj = neck })
        end
    end

    -- тёмная подложка под текст (слева плотнее, справа видно лаву)
    local darkOverlay = Instance.new("Frame")
    darkOverlay.Size = UDim2.fromScale(1, 1)
    darkOverlay.BackgroundColor3 = Color3.fromRGB(8, 0, 16)
    darkOverlay.BackgroundTransparency = 0
    darkOverlay.BorderSizePixel = 0
    darkOverlay.ZIndex = 3
    darkOverlay.Parent = notifFrame

    local overlayGradient = Instance.new("UIGradient")
    overlayGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(0.55, 0.5),
        NumberSequenceKeypoint.new(1, 0.8),
    })
    overlayGradient.Parent = darkOverlay

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2.5
    stroke.Transparency = 0.05
    stroke.Parent = notifFrame

    local strokeGradient = Instance.new("UIGradient")
    strokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 220, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(170, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 255))
    })
    strokeGradient.Parent = stroke

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 24)
    titleLabel.Position = UDim2.new(0, 12, 0, 11)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "Rebzyyx Hub"
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    titleLabel.TextStrokeTransparency = 0.2
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.TextSize = 16
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 4
    titleLabel.Parent = notifFrame

    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -20, 0, 20)
    descLabel.Position = UDim2.new(0, 12, 0, 36)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = "AIM PENAAAAA"
    descLabel.TextColor3 = Color3.fromRGB(235, 150, 255)
    descLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    descLabel.TextStrokeTransparency = 0.3
    descLabel.Font = Enum.Font.SourceSansBold
    descLabel.TextSize = 14
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.ZIndex = 4
    descLabel.Parent = notifFrame

    local conn
    local startTime = tick()
    conn = RunService.RenderStepped:Connect(function()
        local t = tick() - startTime
        strokeGradient.Rotation = (t * -50) % 360

        -- движение капель
        for _, b in ipairs(blobs) do
            local x = b.xBase + math.sin(t * b.xSpeed + b.phaseX) * b.xAmp
            local y = H / 2 + math.sin(t * b.ySpeed + b.phaseY) * (H / 2 + b.r * 0.4)
            local vy = math.abs(math.cos(t * b.ySpeed + b.phaseY)) -- 0 на краях, 1 в середине пути

            -- вытягивание по вертикали при движении + лёгкое "дрожание", площадь сохраняем
            local stretch = 1 + 0.22 * vy + 0.05 * math.sin(t * 5 + b.phaseX)
            local w = (b.r * 2) / math.sqrt(stretch)
            local h = (b.r * 2) * math.sqrt(stretch)

            b.cx, b.cy = x, y
            b.obj.Size = UDim2.fromOffset(w, h)
            b.obj.Position = UDim2.fromOffset(x, y)
            b.glow.Size = UDim2.fromOffset(w * 1.8, h * 1.8)
            b.glow.Position = UDim2.fromOffset(x, y)
        end

        -- перемычки: чем ближе капли, тем толще "шейка"
        for _, n in ipairs(necks) do
            local a, b = blobs[n.i], blobs[n.j]
            local dx, dy = b.cx - a.cx, b.cy - a.cy
            local d = math.sqrt(dx * dx + dy * dy)
            local touch = (a.r + b.r) * 0.6
            local reach = (a.r + b.r) * 1.5

            if d > 0.01 and d < reach then
                local k = 1 - math.max(0, d - touch) / (reach - touch)
                local thick = math.min(a.r, b.r) * 1.7 * k
                if thick > 1.5 then
                    n.obj.Visible = true
                    n.obj.Size = UDim2.fromOffset(d, thick)
                    n.obj.Position = UDim2.fromOffset((a.cx + b.cx) / 2, (a.cy + b.cy) / 2)
                    n.obj.Rotation = math.deg(math.atan2(dy, dx))
                else
                    n.obj.Visible = false
                end
            else
                n.obj.Visible = false
            end
        end
    end)

    TweenService:Create(notifFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -325, 0, 20)
    }):Play()

    task.spawn(function()
        task.wait(4.2)
        local tweenOut = TweenService:Create(notifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 350, 0, 20)
        })
        tweenOut:Play()
        tweenOut.Completed:Wait()

        if conn then conn:Disconnect() end
        screenGui:Destroy()
    end)
end

