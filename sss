            sub.BackgroundTransparency = 1
            sub.Text = u.creator and "Creator" or "пользователь скрипта"
            sub.TextColor3 = u.creator and Color3.fromRGB(200, 150, 255) or Color3.fromRGB(150, 145, 175)
            sub.Font = u.creator and Enum.Font.GothamBold or Enum.Font.Gotham
            sub.TextSize = 11
            sub.TextXAlignment = Enum.TextXAlignment.Left
            sub.Parent = frame

            local dist = Instance.new("TextLabel")
            dist.Position = UDim2.new(1, -78, 0, 0)
            dist.Size = UDim2.fromOffset(72, 38)
            dist.BackgroundTransparency = 1
            dist.Text = "-"
            dist.TextColor3 = Color3.fromRGB(225, 225, 235)
            dist.Font = Enum.Font.Gotham
