    -- ---------------- создание / удаление ----------------
    local function placeMark()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end

        local mouse = UserInputService:GetMouseLocation()
        local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)

        local ignore = { cam }
        if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = ignore

        local result = Workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
        if not result then
            showToast("Нет точки для метки (смотри на поверхность)", Color3.fromRGB(200, 200, 210))
            return nil
        end

        local p = result.Position
        local entry = getPlaceEntry(true)
        entry.name = CurrentPlaceName

        local mark = {
            id = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999)),
            x = p.X, y = p.Y, z = p.Z,
            creator = LocalPlayer.Name,
            t = os.time(),
        }
        table.insert(entry.marks, mark)
        saveMarks()
        MarksDirty = true

        showToast(string.format("Метка: %d %d %d", math.floor(p.X + 0.5), math.floor(p.Y + 0.5), math.floor(p.Z + 0.5)), Color3.fromRGB(120, 200, 255))
        return mark
    end

    -- Отправка метки другим пользователям скрипта (двойное нажатие V сразу после постановки метки)
    local function shareMark(mark)
        local gray = Color3.fromRGB(200, 200, 210)
        if not mark then
            showToast("Сначала поставь метку (V), потом быстро нажми V ещё раз", gray)
            return
        end
        if not NetSend or not Settings.Network then
            showToast("Сеть скрипта выключена", gray)
            return
        end
        if mark.shared then
            showToast("Эта метка уже отправлена", gray)
            return
        end
        local remaining = CooldownState.shareEnd - os.clock()
        if remaining > 0 then
            showToast("КД общих меток: " .. math.ceil(remaining) .. " с", gray)
            return
        end
        CooldownState.shareEnd = os.clock() + SHARE_COOLDOWN
        mark.shared = true
        saveMarks()
        NetSend({ k = "mark", id = mark.id, x = mark.x, y = mark.y, z = mark.z })
        showToast("Метка отправлена пользователям скрипта", Color3.fromRGB(190, 120, 255))
    end

