-- ==========================================
-- ФРИКАМ (по умолчанию клавиша M; меняется кнопкой "Бинд фрикама" в худе)
-- Камера свободно летает и проходит сквозь стены, персонаж стоит на месте.
-- WASD - движение, E / Space - вверх, Q / Ctrl - вниз, Shift - быстрее, колесо - скорость,
-- зажатая ПКМ - поворот камеры. Повторное нажатие клавиши фрикама - выход (камера возвращается на место).
-- ==========================================
local ContextActionService = game:GetService("ContextActionService")

local FREECAM_KEY = Enum.KeyCode.Delete
local FREECAM_SINK_ACTION = "RebzyyxFreecamSink"
local FREECAM_BIND = "RebzyyxFreecam"

Freecam.Speed = 50          -- студов/сек
Freecam.FastMultiplier = 3  -- с зажатым Shift
Freecam.Sensitivity = 0.25  -- градусов на пиксель
Freecam.Pitch = 0
Freecam.Yaw = 0
Freecam.Position = Vector3.new()
Freecam.Looking = false

local function freecamStep(dt)
    local cam = Workspace.CurrentCamera
    if not cam then return end
    cam.CameraType = Enum.CameraType.Scriptable -- игровая камера могла вернуть свой тип

    if Freecam.Looking then
        local delta = UserInputService:GetMouseDelta()
        Freecam.Yaw = Freecam.Yaw - delta.X * Freecam.Sensitivity
        Freecam.Pitch = math.clamp(Freecam.Pitch - delta.Y * Freecam.Sensitivity, -89, 89)
    end

    local rot = CFrame.Angles(0, math.rad(Freecam.Yaw), 0) * CFrame.Angles(math.rad(Freecam.Pitch), 0, 0)

    local flat = Vector3.new()
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then flat = flat + Vector3.new(0, 0, -1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then flat = flat + Vector3.new(0, 0, 1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then flat = flat + Vector3.new(-1, 0, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then flat = flat + Vector3.new(1, 0, 0) end

    local vertical = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = vertical - 1 end

    local speed = Freecam.Speed
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        speed = speed * Freecam.FastMultiplier
    end

    local move = rot:VectorToWorldSpace(flat) + Vector3.new(0, vertical, 0)
    if move.Magnitude > 0 then
        Freecam.Position = Freecam.Position + move.Unit * speed * dt
    end

    -- игра перебила камеру с прошлого кадра? (диагностика для консоли)
    if (cam.CFrame.Position - Freecam.TargetCFrame.Position).Magnitude > 0.5 then
        Freecam.Overrides = Freecam.Overrides + 1
        if tick() - Freecam.LastWarn > 3 then
            Freecam.LastWarn = tick()
            warn("[Rebzyyx] Фрикам: игра перебивает камеру (раз: " .. Freecam.Overrides .. "), я возвращаю её обратно")
        end
    end

    -- камера не проверяет коллизии, поэтому свободно проходит сквозь стены
    Freecam.TargetCFrame = CFrame.new(Freecam.Position) * rot
    cam.CFrame = Freecam.TargetCFrame
end

-- Игра (Rust-подобная, со своей камерой и вьюмоделью) может возвращать камеру на место в любой момент кадра.
-- Поэтому нашу позицию возвращаем ещё и мгновенно при любой попытке её изменить, и в конце кадра.
local function freecamReassert()
    if not Freecam.Active then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    if cam.CameraType ~= Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Scriptable
    end
    if cam.CFrame ~= Freecam.TargetCFrame then
        cam.CFrame = Freecam.TargetCFrame
    end
end

local function freecamHookCamera(cam)
    for _, c in ipairs(Freecam.Conns) do c:Disconnect() end
    Freecam.Conns = {}
    if not cam then return end
    table.insert(Freecam.Conns, cam:GetPropertyChangedSignal("CFrame"):Connect(freecamReassert))
    table.insert(Freecam.Conns, cam:GetPropertyChangedSignal("CameraType"):Connect(freecamReassert))
    table.insert(Freecam.Conns, RunService.RenderStepped:Connect(freecamReassert))
    table.insert(Freecam.Conns, RunService.Heartbeat:Connect(freecamReassert))
end

local function stopFreecam()
    if not Freecam.Active then return end
    Freecam.Active = false

    pcall(function() RunService:UnbindFromRenderStep(FREECAM_BIND) end)
    pcall(function() ContextActionService:UnbindAction(FREECAM_SINK_ACTION) end)
    for _, c in ipairs(Freecam.Conns) do c:Disconnect() end
    Freecam.Conns = {}
    if Freecam.SwapConn then
        Freecam.SwapConn:Disconnect()
        Freecam.SwapConn = nil
    end

    if Freecam.Looking then
        Freecam.Looking = false
        if Freecam.SavedMouseBehavior then
            UserInputService.MouseBehavior = Freecam.SavedMouseBehavior
        end
    end

    -- возвращаем камеру и персонажа как были
    local cam = Workspace.CurrentCamera
    if cam then
        cam.CameraType = Freecam.SavedType or Enum.CameraType.Custom
        if Freecam.SavedSubject then cam.CameraSubject = Freecam.SavedSubject end
        if Freecam.SavedCFrame then cam.CFrame = Freecam.SavedCFrame end
    end
    if Freecam.FrozenRoot and Freecam.FrozenRoot.Parent then
        Freecam.FrozenRoot.Anchored = Freecam.WasAnchored or false
    end
    Freecam.FrozenRoot = nil

    showToast("Фрикам ВЫКЛ", Color3.fromRGB(200, 200, 210))
end

local function startFreecam()
    local cam = Workspace.CurrentCamera
    if not cam or Freecam.Active then return end
    Freecam.Active = true

    Freecam.SavedType = cam.CameraType
    Freecam.SavedSubject = cam.CameraSubject
    Freecam.SavedCFrame = cam.CFrame

    local rx, ry = cam.CFrame:ToOrientation()
    Freecam.Pitch = math.deg(rx)
    Freecam.Yaw = math.deg(ry)
    Freecam.Position = cam.CFrame.Position
    Freecam.TargetCFrame = cam.CFrame
    Freecam.Overrides = 0

    -- персонаж стоит на месте
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if root then
        Freecam.FrozenRoot = root
        Freecam.WasAnchored = root.Anchored
        root.AssemblyLinearVelocity = Vector3.new()
        root.Anchored = true
    end

    -- клавиши движения не должны управлять персонажем
    ContextActionService:BindActionAtPriority(FREECAM_SINK_ACTION, function()
        return Enum.ContextActionResult.Sink
    end, false, Enum.ContextActionPriority.High.Value + 100,
        Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
        Enum.KeyCode.Space, Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.LeftControl)

    pcall(function() RunService:UnbindFromRenderStep(FREECAM_BIND) end)
    RunService:BindToRenderStep(FREECAM_BIND, 1000000, freecamStep) -- как можно позже, после игровой камеры
    freecamHookCamera(cam)
    -- если игра подменит объект камеры - цепляемся к новому
    if Freecam.SwapConn then Freecam.SwapConn:Disconnect() end
    Freecam.SwapConn = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if Freecam.Active then freecamHookCamera(Workspace.CurrentCamera) end
    end)

    showToast("Фрикам ВКЛ", Color3.fromRGB(120, 220, 255))
end

-- ==========================================
-- БИНД ФРИКАМА: кнопка в худе, сохраняется в файл
-- ==========================================
local FREECAM_BIND_FILE = "RebzyyxHub_freecam.txt"
local lastBindLabel = ""

local function freecamBindName()
    if Freecam.BindKind == "vk" then
        local name = (Freecam.BindVk == 5 and "Mouse 4") or (Freecam.BindVk == 6 and "Mouse 5") or ("VK " .. Freecam.BindVk)
        if not Freecam.Mouse4Works then
            name = name .. " (недоступна, пока Delete)"
        end
        return name
    end
    return Freecam.BindKey.Name
end

local function refreshFreecamButton()
    if Freecam.Listening or not Freecam.Button then return end
    local label = "Бинд фрикама: " .. freecamBindName()
    if label ~= lastBindLabel then
        lastBindLabel = label
        Freecam.Button.Text = label
    end
end

local function saveFreecamBind()
    pcall(function()
        if not writefile then return end
        if Freecam.BindKind == "vk" then
            writefile(FREECAM_BIND_FILE, "vk:" .. tostring(Freecam.BindVk))
        else
            writefile(FREECAM_BIND_FILE, "key:" .. Freecam.BindKey.Name)
        end
    end)
end

local function loadFreecamBind()
    pcall(function()
        if not (isfile and readfile and isfile(FREECAM_BIND_FILE)) then return end
        local kind, value = string.match(readfile(FREECAM_BIND_FILE), "^(%a+):(.+)$")
        if kind == "vk" and tonumber(value) then
            Freecam.BindKind = "vk"
            Freecam.BindVk = tonumber(value)
        elseif kind == "key" then
            local ok, keyCode = pcall(function() return Enum.KeyCode[value] end)
            if ok and keyCode then
                Freecam.BindKind = "key"
                Freecam.BindKey = keyCode
            end
        end
    end)
end
loadFreecamBind()

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if HudKeyListening then return end

    -- режим назначения: следующая нажатая клавиша становится биндом фрикама (Esc - отмена)
    if Freecam.Listening then
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
            Freecam.Listening = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                Freecam.BindKind = "key"
                Freecam.BindKey = input.KeyCode
                saveFreecamBind()
            end
            lastBindLabel = ""
            refreshFreecamButton()
        end
        return
    end

    if UserInputService:GetFocusedTextBox() then return end

    -- Delete - запасная клавиша, пока бинд стоит на Mouse 4/5, а экзекутор не умеет её читать
    local isFreecamKey = (Freecam.BindKind == "key" and input.KeyCode == Freecam.BindKey)
        or (Freecam.BindKind == "vk" and not Freecam.Mouse4Works and input.KeyCode == FREECAM_KEY)

    if isFreecamKey then
        if Freecam.Active then stopFreecam() else startFreecam() end
    elseif Freecam.Active and input.UserInputType == Enum.UserInputType.MouseButton2 then
        Freecam.Looking = true
        Freecam.SavedMouseBehavior = UserInputService.MouseBehavior
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 and Freecam.Looking then
        Freecam.Looking = false
        if Freecam.SavedMouseBehavior then
            UserInputService.MouseBehavior = Freecam.SavedMouseBehavior
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if Freecam.Active and input.UserInputType == Enum.UserInputType.MouseWheel then
        Freecam.Speed = math.clamp(Freecam.Speed * (1.15 ^ input.Position.Z), 5, 600)
    end
end)

-- ==========================================
-- КНОПКИ МЫШИ MOUSE 4 / MOUSE 5 для фрикама
-- В Roblox у UserInputService нет события для боковых кнопок мыши, поэтому они читаются через
-- функцию экзекутора iskeypressed (виртуальные коды Windows: 0x05 = Mouse 4, 0x06 = Mouse 5).
-- ==========================================
local vkWasDown = {}
local mouseWarned = false

local function readVk(vk)
    local ok, down = pcall(iskeypressed, vk)
    if ok then return true, down and true or false end
    return false, false
end

RunService.RenderStepped:Connect(function()
    refreshFreecamButton()

    if not iskeypressed then
        if not mouseWarned then
            mouseWarned = true
            warn("[Rebzyyx] Экзекутор не поддерживает iskeypressed: Mouse 4/5 недоступны. Назначь клавишу кнопкой 'Бинд фрикама' в худе (или оставь Delete)")
        end
        return
    end

    -- не реагируем, когда окно Roblox не в фокусе
    local okActive, active = pcall(function() return isrbxactive == nil or isrbxactive() end)
    if okActive and active == false then
        vkWasDown = {}
        return
    end

    if Freecam.Listening then
        -- ждём нажатие Mouse 4 / Mouse 5 для бинда
        for _, vk in ipairs({ 0x05, 0x06 }) do
            local ok, down = readVk(vk)
            if ok then
                if down and not vkWasDown[vk] then
                    Freecam.Listening = false
                    Freecam.BindKind = "vk"
                    Freecam.BindVk = vk
                    Freecam.Mouse4Works = true
                    saveFreecamBind()
                    lastBindLabel = ""
                end
                vkWasDown[vk] = down
            end
        end
        return
    end

    if Freecam.BindKind == "vk" then
        local ok, down = readVk(Freecam.BindVk)
        if not ok then
            if not mouseWarned then
                mouseWarned = true
                warn("[Rebzyyx] iskeypressed не принял код кнопки мыши: пока работает Delete")
            end
            return
        end

        if not Freecam.Mouse4Works then
            Freecam.Mouse4Works = true
            print("[Rebzyyx] Фрикам: кнопка мыши подключена (Delete отключён)")
        end

        if down and not vkWasDown[Freecam.BindVk] and not HudKeyListening and not UserInputService:GetFocusedTextBox() then
            if Freecam.Active then stopFreecam() else startFreecam() end
        end
        vkWasDown[Freecam.BindVk] = down
    end
end)

-- ==========================================
-- МЕТКИ (клавиша V)
--  * короткое нажатие V - поставить метку в точку под прицелом (луч света + координаты + дистанция)
--  * зажать V (~0.45 сек) - открыть меню меток (там можно удалять, менять цвет и название)
--  * метки сохраняются в файл и привязаны к плейсу (игре); в меню видно, в каких плейсах есть метки
-- Весь блок в отдельной функции, чтобы не упереться в лимит локальных переменных скрипта (200).
-- ==========================================
local function initMarks()
    local MarkHttp = game:GetService("HttpService")
    local MarkMarket = game:GetService("MarketplaceService")

    local MARKS_FILE = "RebzyyxHub_marks.json"
    local MARK_KEY = Enum.KeyCode.V
    local MARK_HOLD_TIME = 0.45     -- сколько держать V, чтобы открыть меню
    local MARK_BEAM_HEIGHT = 9      -- высота луча света (студов)
    local MARK_MIN_PX_HEIGHT = 46   -- минимальная высота луча на экране, чтобы далёкая метка не пропадала
    local MARK_MAX_DISTANCE = math.huge -- метки видны по всей карте

    -- цвета меток (меняются в меню); по умолчанию - синий как на скриншоте
    local MARK_COLORS = {
        { 40, 120, 255 },  -- синий
        { 0, 205, 255 },   -- голубой
        { 60, 255, 120 },  -- зелёный
        { 255, 230, 60 },  -- жёлтый
        { 255, 150, 40 },  -- оранжевый
        { 255, 70, 70 },   -- красный
        { 255, 100, 200 }, -- розовый
        { 180, 90, 255 },  -- фиолетовый
        { 240, 240, 245 }, -- белый
    }

    local function getMarkColor(mark)
        local c = mark.color
        if type(c) == "table" and #c == 3 then
            return Color3.fromRGB(c[1], c[2], c[3])
        end
        local d = MARK_COLORS[1]
        return Color3.fromRGB(d[1], d[2], d[3])
    end

    local function nextMarkColor(mark)
        local current = (type(mark.color) == "table" and #mark.color == 3) and mark.color or MARK_COLORS[1]
        local idx = 1
        for i, c in ipairs(MARK_COLORS) do
            if c[1] == current[1] and c[2] == current[2] and c[3] == current[3] then
                idx = i
                break
            end
        end
        local nextColor = MARK_COLORS[(idx % #MARK_COLORS) + 1]
        mark.color = { nextColor[1], nextColor[2], nextColor[3] }
    end

    local function getMarkAlpha(mark)
        if type(mark.alpha) == "number" then
            return math.clamp(mark.alpha, 0, 1)
        end
        return 1
    end

    local function getMarkName(mark)
        if type(mark.name) == "string" and mark.name ~= "" then
            return mark.name
        end
        return "От " .. tostring(mark.creator or LocalPlayer.Name)
    end

    local PlaceKey = tostring(game.PlaceId)
    local CurrentPlaceName = "Place " .. PlaceKey

    -- { places = { ["<PlaceId>"] = { name = "...", marks = { {id, x, y, z, creator, t} } } } }
    local MarksData = { places = {} }

    local function saveMarks()
        pcall(function()
            if writefile then
                writefile(MARKS_FILE, MarkHttp:JSONEncode(MarksData))
            end
        end)
    end

    local function loadMarks()
        pcall(function()
            if not (isfile and readfile and isfile(MARKS_FILE)) then return end
            local data = MarkHttp:JSONDecode(readfile(MARKS_FILE))
            if type(data) == "table" and type(data.places) == "table" then
                MarksData = data
            end
        end)
    end
    loadMarks()
    MarksData.customColors = MarksData.customColors or {} -- свои цвета из выбора цвета (кнопка +)

    local function getPlaceEntry(create)
        local entry = MarksData.places[PlaceKey]
        if not entry and create then
            entry = { name = CurrentPlaceName, marks = {} }
            MarksData.places[PlaceKey] = entry
        end
        return entry
    end

    -- название плейса (для меню)
    task.spawn(function()
        local ok, info = pcall(function() return MarkMarket:GetProductInfo(game.PlaceId) end)
        if ok and info and info.Name then
            CurrentPlaceName = info.Name
            local entry = MarksData.places[PlaceKey]
            if entry then
                entry.name = info.Name
                saveMarks()
            end
        end
    end)

    local MarksDirty = true
    local removeMarkFn = nil -- присваивается ниже, после объявления removeMark

    -- ---------------- GUI ----------------
    destroyOldGui("RebzyyxMarksGui")
    local MarksGui = Instance.new("ScreenGui")
    MarksGui.Name = "RebzyyxMarksGui"
    MarksGui.ResetOnSpawn = false
    MarksGui.IgnoreGuiInset = true -- координаты WorldToViewportPoint совпадают с экраном
    MarksGui.DisplayOrder = 4
    MarksGui.Parent = GuiParent

    local MarksWorld = Instance.new("Frame")
    MarksWorld.Name = "World"
    MarksWorld.Size = UDim2.fromScale(1, 1)
    MarksWorld.BackgroundTransparency = 1
    MarksWorld.Parent = MarksGui

    local Rendered = {} -- [markId] = { root, glow, core, label, coordLabel, distLabel }

    local function makeLine(parent, order)
        local l = Instance.new("TextLabel")
        l.AutomaticSize = Enum.AutomaticSize.XY
        l.Size = UDim2.fromOffset(0, 0)
        l.BackgroundColor3 = Color3.fromRGB(20, 70, 78)
        l.BackgroundTransparency = 0.15
        l.BorderSizePixel = 0
        l.TextColor3 = Color3.fromRGB(255, 255, 255)
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 13
        l.LayoutOrder = order
        l.Parent = parent
        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 5)
        pad.PaddingRight = UDim.new(0, 5)
        pad.PaddingTop = UDim.new(0, 1)
        pad.PaddingBottom = UDim.new(0, 1)
        pad.Parent = l
        -- мягкий ореол вокруг плашки: имитация размытия подложки текста (настоящего блюра в UI Roblox нет)
        local halo = Instance.new("UIStroke")
        halo.Thickness = 3
        halo.Transparency = 0.78
        halo.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        halo.Parent = l
        return l
    end

    local function makeBeamPart(parent, color, topTransparency, bottomTransparency)
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 1)
        f.BackgroundColor3 = color
        f.BackgroundTransparency = 0
        f.BorderSizePixel = 0
        f.Parent = parent
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = f
        local g = Instance.new("UIGradient")
        g.Rotation = 90 -- сверху вниз: сверху прозрачно, у основания ярко
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, topTransparency),
            NumberSequenceKeypoint.new(1, bottomTransparency),
        })
        g.Parent = f
        return f, g
    end

    -- ---------------- 3D-модель метки: мягкий световой столб + свет + свечение на земле ----------------
    -- Создаётся только когда метка ближе MARK_3D_RADIUS; дальше остаётся только текст.
    local MARK_3D_RADIUS = 680
    local MARK_3D_HIDE_RADIUS = 720   -- небольшой запас, чтобы модель не мерцала на границе
    local MARK_3D_HEIGHT = 11         -- высота столба (студов)
    local DEATH_MARK_VANISH_DISTANCE = 10 -- метка смерти пропадает, когда ты подошёл ближе
    local DEATH_LOCK_SECONDS = 20         -- столько секунд после смерти метку нельзя удалить
    local SHARE_COOLDOWN = 10             -- КД между отправками общих меток

    local function isMarkLocked(m)
        return m.kind == "death" and os.time() < (m.lockUntil or 0)
    end

    do
        local old3D = Workspace:FindFirstChild("RebzyyxMarks3D")
        if old3D then old3D:Destroy() end
    end
    local Marks3D = nil
    local function get3DFolder()
        if Marks3D and Marks3D.Parent then return Marks3D end
        Marks3D = Instance.new("Folder")
        Marks3D.Name = "RebzyyxMarks3D"
        Marks3D.Parent = Workspace
        return Marks3D
    end

    -- слои столба: от широкого прозрачного свечения к узкой яркой сердцевине
    local LAYERS_3D = {
        { w = 5.4, bt = 0.93, mix = 0.0 },
        { w = 3.9, bt = 0.85, mix = 0.05 },
        { w = 2.7, bt = 0.72, mix = 0.15 },
        { w = 1.8, bt = 0.55, mix = 0.35 },
        { w = 1.1, bt = 0.34, mix = 0.6 },
        { w = 0.55, bt = 0.14, mix = 0.85 },
    }

    local function makeFixedPart(parent, name)
        local part = Instance.new("Part")
        part.Name = name
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Parent = parent
        return part
    end

    local function create3D(mark)
        local folder = get3DFolder()
        local pos = Vector3.new(mark.x, mark.y, mark.z)

        local anchor = makeFixedPart(folder, "MarkAnchor")
        anchor.Transparency = 1
        anchor.Size = Vector3.new(0.4, 0.4, 0.4)
        anchor.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0))

        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, 0, 0)
        a0.Parent = anchor
        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(0, MARK_3D_HEIGHT, 0)
        a1.Parent = anchor

        local beams = {}
        for i, def in ipairs(LAYERS_3D) do
            local beam = Instance.new("Beam")
            beam.Attachment0 = a0
            beam.Attachment1 = a1
            beam.Width0 = def.w
            beam.Width1 = def.w * 0.55
            beam.FaceCamera = true      -- столб всегда виден "в профиль" с любой стороны
            beam.LightEmission = 1
            beam.LightInfluence = 0
            beam.Parent = anchor
            beams[i] = { beam = beam, def = def }
        end

        -- мягкий свет, освещающий землю и стены вокруг метки
        local light = Instance.new("PointLight")
        light.Range = 22
        light.Brightness = 1.6
        light.Shadows = false
        light.Parent = anchor

        -- свечение на земле под столбом
        local disc = makeFixedPart(folder, "MarkGlow")
        disc.Shape = Enum.PartType.Cylinder
        disc.Material = Enum.Material.Neon
        disc.Size = Vector3.new(0.1, 7, 7)
        disc.CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))

        return { anchor = anchor, beams = beams, light = light, disc = disc, blink = nil,
                 lightBrightness = 1.6, discTransparency = 0.7 }
    end

    local function apply3DStyle(m3, mark)
        local color = getMarkColor(mark)
        local alpha = getMarkAlpha(mark)
        local white = Color3.fromRGB(255, 255, 255)

        for _, entry in ipairs(m3.beams) do
            local def = entry.def
            entry.beam.Color = ColorSequence.new(color:Lerp(white, def.mix))
            local solid = 1 - (1 - def.bt) * alpha
            entry.solid = solid
            local dim = 1 - (1 - def.bt) * alpha * 0.12 -- "погашенное" состояние для мигания
            entry.seqOn = NumberSequence.new({
                NumberSequenceKeypoint.new(0, solid),
                NumberSequenceKeypoint.new(0.5, solid + (1 - solid) * 0.55),
                NumberSequenceKeypoint.new(1, 1),
            })
            entry.seqOff = NumberSequence.new({
                NumberSequenceKeypoint.new(0, dim),
                NumberSequenceKeypoint.new(1, 1),
            })
            entry.beam.Transparency = entry.seqOn
        end

        m3.lightBrightness = 1.6 * alpha
        m3.light.Color = color
        m3.light.Brightness = m3.lightBrightness
        m3.discTransparency = 1 - 0.3 * alpha
        m3.disc.Color = color
        m3.disc.Transparency = m3.discTransparency
        m3.blink = nil
        m3.lastPulse = nil
    end

    -- мигание (для меток смерти)
    local function set3DBlink(m3, on)
        if m3.blink == on then return end
        m3.blink = on
        for _, entry in ipairs(m3.beams) do
            entry.beam.Transparency = on and entry.seqOn or entry.seqOff
        end
        m3.light.Brightness = on and m3.lightBrightness or m3.lightBrightness * 0.15
        m3.disc.Transparency = on and m3.discTransparency or 0.95
    end

    -- мягкая пульсация яркости (0..1): столб, свет и свечение на земле
    local function set3DPulse(m3, f)
        if m3.lastPulse and math.abs(m3.lastPulse - f) < 0.02 then return end
        m3.lastPulse = f
        for _, entry in ipairs(m3.beams) do
            local solid = 1 - (1 - entry.solid) * f
            entry.beam.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, solid),
                NumberSequenceKeypoint.new(0.5, solid + (1 - solid) * 0.55),
                NumberSequenceKeypoint.new(1, 1),
            })
        end
        m3.light.Brightness = m3.lightBrightness * f
        m3.disc.Transparency = 1 - (1 - m3.discTransparency) * f
    end

    local function destroy3D(visual)
        local m3 = visual.m3
        if not m3 then return end
        visual.m3 = nil
        pcall(function() m3.anchor:Destroy() end)
        pcall(function() m3.disc:Destroy() end)
    end

    -- применяет цвет и название метки к уже созданному визуалу
    local function applyMarkStyle(visual, mark)
        local color = getMarkColor(mark)
        local alpha = getMarkAlpha(mark)
        for _, layer in ipairs(visual.layers) do
            layer.f.BackgroundColor3 = color:Lerp(Color3.fromRGB(255, 255, 255), layer.mix)
            -- общая прозрачность метки (ползунок "Прозрачность" в выборе цвета)
            layer.g.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 1 - (1 - layer.bt) * alpha),
            })
        end

        local plate = Color3.fromRGB(20, 70, 78):Lerp(color, 0.35)
        for _, line in ipairs({ visual.coordLabel, visual.nameLabel, visual.distLabel }) do
            line.BackgroundColor3 = plate
            local halo = line:FindFirstChildOfClass("UIStroke")
            if halo then halo.Color = plate end
        end

        visual.nameLabel.Text = getMarkName(mark)

        if visual.m3 then apply3DStyle(visual.m3, mark) end
    end

    local function createMarkVisual(mark)
        local root = Instance.new("Frame")
        root.Size = UDim2.fromScale(1, 1)
        root.BackgroundTransparency = 1
        root.Parent = MarksWorld

        -- слои от внешнего мягкого свечения к яркой сердцевине (w - ширина в студах, minPx - минимум на экране)
        local white = Color3.fromRGB(255, 255, 255)
        -- 6 слоёв: плавный переход от широкого мягкого свечения к яркой узкой сердцевине (bt - непрозрачность у основания)
        local layerDefs = {
            { w = 4.6, minPx = 22, mix = 0.0, bt = 0.9 },
            { w = 3.4, minPx = 17, mix = 0.05, bt = 0.8 },
            { w = 2.4, minPx = 12, mix = 0.15, bt = 0.65 },
            { w = 1.6, minPx = 8, mix = 0.35, bt = 0.45 },
            { w = 1.0, minPx = 5, mix = 0.6, bt = 0.25 },
            { w = 0.5, minPx = 3, mix = 0.85, bt = 0.08 },
        }
        local layers = {}
        for i, def in ipairs(layerDefs) do
            local f, g = makeBeamPart(root, white, 1, def.bt)
            f.Visible = false -- 2D-столб отключён: вместо него 3D-модель рядом и текст всегда
            layers[i] = { f = f, g = g, w = def.w, minPx = def.minPx, mix = def.mix, bt = def.bt }
        end

        local label = Instance.new("Frame")
        label.AnchorPoint = Vector2.new(0.5, 0)
        label.AutomaticSize = Enum.AutomaticSize.XY
        label.Size = UDim2.fromOffset(0, 0)
        label.BackgroundTransparency = 1
        label.Parent = root
        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.Padding = UDim.new(0, 1)
        layout.Parent = label

        local coordLabel = makeLine(label, 1)
        coordLabel.Text = string.format("%d %d %d", math.floor(mark.x + 0.5), math.floor(mark.y + 0.5), math.floor(mark.z + 0.5))
        local nameLabel = makeLine(label, 2)
        local distLabel = makeLine(label, 3)
        distLabel.Text = "Дистанция: -"

        local visual = {
            root = root, layers = layers, label = label,
            coordLabel = coordLabel, nameLabel = nameLabel, distLabel = distLabel,
        }
        applyMarkStyle(visual, mark)
        return visual
    end

    -- все метки для отрисовки: свои (сохранённые) + метки других пользователей скрипта
    local function allMarks()
        local list = {}
        local entry = MarksData.places[PlaceKey]
        if entry then
            for _, m in ipairs(entry.marks) do list[#list + 1] = m end
        end
        for _, m in pairs(PeerMarks) do list[#list + 1] = m end
        return list
    end

    local seenPeerVersion = -1

    local function syncWorldMarks()
        MarksDirty = false
        seenPeerVersion = PeerState.version
        local alive = {}
        do
            for _, m in ipairs(allMarks()) do
                alive[m.id] = true
                if not Rendered[m.id] then
                    Rendered[m.id] = createMarkVisual(m)
                else
                    applyMarkStyle(Rendered[m.id], m) -- цвет/название могли измениться
                end
            end
        end
        for id, visual in pairs(Rendered) do
            if not alive[id] then
                destroy3D(visual)
                visual.root:Destroy()
                Rendered[id] = nil
            end
        end
    end

    -- отрисовка меток каждый кадр
    local function marksStep()
        if MarksDirty or seenPeerVersion ~= PeerState.version then syncWorldMarks() end

        local marksList = allMarks()
        local cam = Workspace.CurrentCamera
        if #marksList == 0 or not cam then return end

        local vp = cam.ViewportSize
        local myChar = LocalPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
        local refPos = myRoot and myRoot.Position or cam.CFrame.Position
        local focal = (vp.Y / 2) / math.tan(math.rad(cam.FieldOfView / 2))
        -- плавная пульсация 0.4..1.0 (период около 2.6 секунды) для меток смерти и меток других пользователей
        local pulse = 0.4 + 0.6 * (0.5 + 0.5 * math.sin(tick() * 2.4))

        local toRemove = {}

        for _, m in ipairs(marksList) do
            local v = Rendered[m.id]
            if v then
                local pos = Vector3.new(m.x, m.y, m.z)
                local base = cam:WorldToViewportPoint(pos)
                local dist = (pos - refPos).Magnitude

                -- метка смерти исчезает, когда ты подошёл к ней вплотную
                if m.kind == "death" and myRoot and dist <= DEATH_MARK_VANISH_DISTANCE and not isMarkLocked(m) then
                    table.insert(toRemove, m.id)
                end

                -- 3D-модель: появляется в радиусе 680 студов, дальше остаётся только текст
                if dist <= MARK_3D_RADIUS then
                    if v.m3 and not v.m3.anchor.Parent then destroy3D(v) end -- игра могла удалить объект
                    if not v.m3 then
                        v.m3 = create3D(m)
                        apply3DStyle(v.m3, m)
                    end
                    if m.kind == "death" or m.kind == "peer" then set3DPulse(v.m3, pulse) end
                elseif dist > MARK_3D_HIDE_RADIUS and v.m3 then
                    destroy3D(v)
                end

                -- текст виден всегда (подпись у основания; если основание за краем экрана - прижимаем к краю)
                if base.Z <= 0 or dist > MARK_MAX_DISTANCE then
                    v.root.Visible = false -- метка позади камеры
                else
                    v.root.Visible = true

                    local lx = math.clamp(base.X, 90, math.max(vp.X - 90, 91))
                    local ly = math.clamp(base.Y + 6, 10, math.max(vp.Y - 70, 11))
                    v.label.Position = UDim2.fromOffset(lx, ly)

                    if dist < 100 then
                        v.distLabel.Text = string.format("Дистанция: %.1f", dist)
                    else
                        v.distLabel.Text = "Дистанция: " .. math.floor(dist + 0.5)
                    end
                end
            end
        end

        if #toRemove > 0 then
            for _, id in ipairs(toRemove) do
                removeMarkFn(PlaceKey, id)
            end
            showToast("Метка смерти убрана", Color3.fromRGB(200, 200, 210))
        end
    end

