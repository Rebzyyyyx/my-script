local SETTINGS_FILE = "RebzyyxHub_settings.json"
local SavedExtras = {} -- прочие сохранённые значения (например, радиус стрелок)

local function serializeValue(v)
    local t = typeof(v)
    if t == "boolean" or t == "number" or t == "string" then
        return v
    elseif t == "EnumItem" then
        return { enum = tostring(v.EnumType), name = v.Name }
    end
    return nil
end

local function deserializeValue(v, current)
    if type(v) == "table" and v.enum and v.name then
        local ok, item = pcall(function() return Enum[v.enum][v.name] end)
        if ok and item then return item end
        return nil
    end
    if typeof(v) == typeof(current) then return v end -- тип должен совпадать с текущим значением
    return nil
end

local function loadSettings()
    pcall(function()
        if not (isfile and readfile and isfile(SETTINGS_FILE)) then return end
        local data = game:GetService("HttpService"):JSONDecode(readfile(SETTINGS_FILE))
        if type(data) ~= "table" then return end
        if type(data.Settings) == "table" then
            for key, value in pairs(data.Settings) do
                local current = Settings[key]
                if current ~= nil then
                    local v = deserializeValue(value, current)
                    if v ~= nil then Settings[key] = v end
                end
            end
        end
        if type(data.Extras) == "table" then SavedExtras = data.Extras end
    end)
end
loadSettings()

