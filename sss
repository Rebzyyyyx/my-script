    -- детерминированный, но "гуляющий" сдвиг на цель (чтобы было похоже на баг, а не на мигающий глюк)
    local function offsetFor(userId)
        local off = BlacklistOffset[userId]
        if not off then
            local seed = Random.new(userId + os.time())
            off = { ang = seed:NextNumber(0, math.pi * 2), r = seed:NextNumber(12, 28), phase = seed:NextNumber(0, 6) }
            BlacklistOffset[userId] = off
        end
        local t = tick() * 0.15 + off.phase
        local ang = off.ang + math.sin(t) * 0.6
        return Vector3.new(math.cos(ang) * off.r, math.sin(t * 1.7) * 3, math.sin(ang) * off.r)
    end

    -- Глобальный доступ для ESP/аимбота: если Я в ЧС, каждая позиция игрока искажается.
    -- (значения читаются из espStep / aimStep - видно по использованию ниже GetEspPosition / GetAimPosition)
    _G.RebzyyxGetDisplayPosition = function(userId, realPos)
        if not IsSabotaged then return realPos end
        return realPos + offsetFor(userId)
    end

