    local function removeMark(placeKey, markId)
        local entry = MarksData.places[placeKey]
        if not entry then return end
        for i, m in ipairs(entry.marks) do
            if m.id == markId then
                if m.shared and NetSend then
                    NetSend({ k = "unmark", id = m.id }) -- убираем метку и у остальных
                end
                table.remove(entry.marks, i)
                break
            end
        end
        if #entry.marks == 0 then
            MarksData.places[placeKey] = nil -- у плейса не осталось меток
        end
        saveMarks()
        MarksDirty = true
    end

