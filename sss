-- ==========================================
local HudParticles = {}
local MAX_HUD_PARTICLES = 150

local function burstHudParticles(origin, color, count)
    for _ = 1, count do
        if #HudParticles >= MAX_HUD_PARTICLES then break end

        local size = math.random(3, 6)
        local obj = Instance.new("Frame")
        obj.AnchorPoint = Vector2.new(0.5, 0.5)
        obj.Size = UDim2.fromOffset(size, size)
        obj.Position = UDim2.fromOffset(origin.X, origin.Y)
        obj.BackgroundColor3 = color
        obj.BackgroundTransparency = 0.15
        obj.BorderSizePixel = 0
        obj.ZIndex = 20
        obj.Parent = ParticleLayer
        Instance.new("UICorner", obj).CornerRadius = UDim.new(1, 0)

        local angle = math.rad(math.random(0, 360))
        local speed = math.random(120, 280)
        table.insert(HudParticles, {
            obj = obj,
            x = origin.X,
            y = origin.Y,
            vx = math.cos(angle) * speed,
            vy = math.sin(angle) * speed,
            half = size / 2,
            life = 0,
            maxLife = 1.4 + math.random() * 1.2,
        })
    end
end

RunService.RenderStepped:Connect(function(dt)
    if #HudParticles == 0 then return end

    local W, H = MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y
    local drag = 1 - math.clamp(0.35 * dt, 0, 1)

    for i = #HudParticles, 1, -1 do
        local p = HudParticles[i]
        p.life = p.life + dt

        if p.life >= p.maxLife or not p.obj.Parent then
            p.obj:Destroy()
            table.remove(HudParticles, i)
        else
            p.x = p.x + p.vx * dt
            p.y = p.y + p.vy * dt
            p.vx = p.vx * drag
            p.vy = p.vy * drag

            -- отскок от стенок худа
            if p.x < p.half then
                p.x = p.half
                p.vx = math.abs(p.vx) * 0.92
            elseif p.x > W - p.half then
                p.x = W - p.half
                p.vx = -math.abs(p.vx) * 0.92
            end
            if p.y < p.half then
                p.y = p.half
                p.vy = math.abs(p.vy) * 0.92
            elseif p.y > H - p.half then
                p.y = H - p.half
                p.vy = -math.abs(p.vy) * 0.92
            end

            p.obj.Position = UDim2.fromOffset(p.x, p.y)
            local fade = math.clamp((p.maxLife - p.life) / 0.5, 0, 1)
            p.obj.BackgroundTransparency = 1 - 0.85 * fade
        end
    end
end)

