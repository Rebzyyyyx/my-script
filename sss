-- ==========================================
-- ТРЕКЕР ПАТРОНОВ: зелёный - попал в цель, красный - промах
-- Луч идёт от оружия в точку, куда смотрит прицел
-- ==========================================
local TracerHitColor = Color3.fromRGB(40, 255, 90)
local TracerMissColor = Color3.fromRGB(255, 50, 60)
local TracerFireInterval = 0.1 -- при удержании кнопки мыши
local TracerRange = 1000

local tracerHeld = false
local tracerTimer = 0
local tracerParams = RaycastParams.new()
tracerParams.FilterType = Enum.RaycastFilterType.Exclude
tracerParams.IgnoreWater = true

local function fireTracer()
    if not Settings.BulletTracers or Freecam.Active then return end

    local cam = Workspace.CurrentCamera
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not cam or not tool then return end -- трейсер только когда в руках оружие/предмет

    local muzzlePart = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart") or char:FindFirstChild("Head")
    if not muzzlePart then return end
    local origin = muzzlePart.Position

    local mouse = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)

    tracerParams.FilterDescendantsInstances = { char, cam }
    local result = Workspace:Raycast(ray.Origin, ray.Direction * TracerRange, tracerParams)
    local hitPos = result and result.Position or (ray.Origin + ray.Direction * TracerRange)

    -- попали ли в живого персонажа (игрок или NPC)
    local hit = false
    if result and result.Instance then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        local hum = model and model:FindFirstChildOfClass("Humanoid")
        hit = (hum ~= nil and hum.Health > 0)
    end

    local color = hit and TracerHitColor or TracerMissColor
    local dist = (hitPos - origin).Magnitude
    if dist < 0.5 then return end

    local beam = Instance.new("Part")
    beam.Anchored = true
    beam.CanCollide = false
    beam.CanQuery = false
    beam.CanTouch = false
    beam.CastShadow = false
    beam.Material = Enum.Material.Neon
    beam.Color = color
    beam.Transparency = 0.1
    beam.Size = Vector3.new(0.12, 0.12, dist)
    beam.CFrame = CFrame.lookAt(origin, hitPos) * CFrame.new(0, 0, -dist / 2)
    beam.Parent = cam

    TweenService:Create(beam, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Transparency = 1,
        Size = Vector3.new(0.02, 0.02, dist),
    }):Play()

    -- вспышка в точке попадания / промаха
    local spot = Instance.new("Part")
    spot.Shape = Enum.PartType.Ball
    spot.Anchored = true
    spot.CanCollide = false
    spot.CanQuery = false
    spot.CanTouch = false
    spot.CastShadow = false
    spot.Material = Enum.Material.Neon
    spot.Color = color
    spot.Transparency = 0.1
    spot.Size = Vector3.new(0.5, 0.5, 0.5)
    spot.Position = hitPos
    spot.Parent = cam

    TweenService:Create(spot, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Transparency = 1,
        Size = Vector3.new(1.6, 1.6, 1.6),
    }):Play()

    local debris = game:GetService("Debris")
    debris:AddItem(beam, 0.7)
    debris:AddItem(spot, 0.5)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or IsRobloxMenuOpen then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        tracerHeld = true
        tracerTimer = 0
        fireTracer()
    end
end)

