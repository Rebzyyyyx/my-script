-- ==========================================
-- СВЕТ В ТЁМНЫХ МЕСТАХ
-- Когда вокруг тебя темно (замкнутое помещение / ночь и рядом нет ламп), вокруг появляются невидимые
-- источники мягкого света в радиусе 200 / 350 / 400 студов (кнопка в худе). Яркость плавно нарастает
-- и намеренно слабая, чтобы не слепить; лампы рядом с камерой ещё тусклее. Стало светло - плавно гаснут.
-- Тьма определяется по признакам (скрипт не видит свет "по пикселям"):
--   * потолок над тобой и/или стены в радиусе 5 студов = помещение/пещера;
--   * ночное время суток; * рядом нет включённых ламп.
-- ==========================================
do
local function initDarkLights()
    local Lighting = game:GetService("Lighting")

    local LIGHT_RANGE = 60            -- максимальный радиус одного источника в Roblox
    local LIGHT_BASE_BRIGHTNESS = 0.9 -- яркость (увеличена; всё ещё гасится вблизи камеры, чтобы не слепило)
    local LIGHT_COLOR = Color3.fromRGB(255, 240, 220)
    local CHECK_INTERVAL = 0.2
    local RISE = 1.0                  -- плавное включение (около секунды)
    local FALL = 0.7
    local NV_RADIUS = 9                -- радиус проверки стен вокруг персонажа (было 5 - не видело стены просторных комнат)
    local DARK_LEVEL = 0.35            -- порог "на улице реально темно" (0 = чёрная ночь, 1 = полдень)
    local NV_AT_NIGHT = true
    local MAX_LIGHTS = 56
    local NEAR_CAMERA_FADE = 14       -- источники ближе этого к камере тускнеют
    local LIGHT_SEARCH = 45           -- где искать уже горящие лампы

    -- убираем прошлую версию "ночного зрения" (яркость/экспозиция), если она осталась
    local oldEffect = Lighting:FindFirstChild("RebzyyxNightVision")
    if oldEffect then oldEffect:Destroy() end
    local oldFolder = Workspace:FindFirstChild("RebzyyxNightLights")
    if oldFolder then oldFolder:Destroy() end

    local folder = nil
    local function getFolder()
        if folder and folder.Parent then return folder end
        folder = Instance.new("Folder")
        folder.Name = "RebzyyxNightLights"
        folder.Parent = Workspace
        return folder
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.MaxParts = 200

    local function refreshFilters(char)
        local ignore = {}
        if char then table.insert(ignore, char) end
        local cam = Workspace.CurrentCamera
        if cam then table.insert(ignore, cam) end
        for _, name in ipairs({ "RebzyyxMarks3D", "RebzyyxNightLights" }) do
            local obj = Workspace:FindFirstChild(name) -- свет наших объектов не считается освещением
            if obj then table.insert(ignore, obj) end
        end
        rayParams.FilterDescendantsInstances = ignore
        overlapParams.FilterDescendantsInstances = ignore
    end

    local function hasNearbyLight(pos)
        local parts = Workspace:GetPartBoundsInRadius(pos, LIGHT_SEARCH, overlapParams)
        for _, part in ipairs(parts) do
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Light") and child.Enabled and child.Brightness > 0.1 then
                    if (part.Position - pos).Magnitude <= child.Range + 2 then
                        return true
                    end
                end
            end
        end
        return false
    end

    -- есть ли потолок НАД этой конкретной точкой (не обязательно прямо над игроком - используется
    -- для нескольких точек вокруг него, чтобы ловить и большие залы, а не только маленькие комнатки)
    local function hasRoofAt(pos)
        local up = Workspace:Raycast(pos, Vector3.new(0, 150, 0), rayParams)
        return up ~= nil and (up.Position - pos).Magnitude <= 20
    end

    local function isEnclosed(origin)
        if not hasRoofAt(origin) then return false end -- прямо над головой открытое небо - точно не помещение

        local blocked = 0
        for i = 0, 7 do
            local ang = i * math.pi / 4
            local dir = Vector3.new(math.cos(ang), 0, math.sin(ang)) * NV_RADIUS
            if Workspace:Raycast(origin, dir, rayParams) then blocked = blocked + 1 end
        end
        if blocked >= 2 then return true end -- рядом стены и потолок - маленькая комната

        -- большой зал: стен рядом может не быть, но потолок есть и дальше во все стороны - тоже помещение
        local roofedFar = 0
        for i = 0, 3 do
            local ang = i * math.pi / 2 + math.pi / 4
            local pos = origin + Vector3.new(math.cos(ang), 0, math.sin(ang)) * (NV_RADIUS * 2.2)
            if hasRoofAt(pos) then roofedFar = roofedFar + 1 end
        end
        return roofedFar >= 3
    end

    -- оценка общего уровня освещения сцены (0 - кромешная тьма, 1 - яркий день), не зависит от того,
    -- каким способом игра анимирует смену дня и ночи (ClockTime или напрямую Brightness/Ambient)
    local function sceneLightLevel()
        -- перцептивная яркость: синий канал почти не влияет, иначе насыщенный "ночной синий" (высокий HSV value)
        -- ошибочно считался бы светлым, хотя сцена явно тёмная
        local function luma(c) return c.R * 0.3 + c.G * 0.59 + c.B * 0.11 end
        local ambient = (luma(Lighting.Ambient) + luma(Lighting.OutdoorAmbient)) * 0.5
        local sun = math.clamp(Lighting.Brightness / 2, 0, 1) -- Brightness около 2 в ясный полдень
        return math.clamp(ambient * 0.6 + sun * 0.4, 0, 1)
    end

    local function computeTarget()
        local radius = Settings.LightRadius
        if not radius or radius <= 0 then return 0 end
        local char = LocalPlayer.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return 0 end

        refreshFilters(char)
        local origin = root.Position + Vector3.new(0, 1.5, 0)

        local nightOutside = NV_AT_NIGHT and sceneLightLevel() < DARK_LEVEL
        local enclosed = isEnclosed(origin)
        if not (nightOutside or enclosed) then return 0 end

        -- в помещении темно само по себе (туда не достаёт уличный свет), а вот снаружи считаем тёмным,
        -- только если на сцене правда темно - иначе солнечным днём эффект нигде не включится зря
        if not enclosed and not nightOutside then return 0 end
        if hasNearbyLight(root.Position) then return 0 end
        return 1
    end

    -- ---------- источники света сеткой вокруг игрока ----------
    local cells = {} -- [ключ клетки] = { part, light, d } или { empty = true, retryAt = время }

    local function clearCells()
        for key, cell in pairs(cells) do
            if cell.part then cell.part:Destroy() end
            cells[key] = nil
        end
    end

    local function updateCells(origin, radius)
        local size = math.max(70, radius / 4)
        local cx0, cz0 = math.floor(origin.X / size), math.floor(origin.Z / size)
        local span = math.ceil(radius / size)

        local list = {}
        for ix = -span, span do
            for iz = -span, span do
                local cx, cz = cx0 + ix, cz0 + iz
                local px, pz = (cx + 0.5) * size, (cz + 0.5) * size
                local dx, dz = px - origin.X, pz - origin.Z
                local d = math.sqrt(dx * dx + dz * dz)
                if d <= radius then
                    list[#list + 1] = { key = cx .. ":" .. cz, x = px, z = pz, d = d }
                end
            end
        end
        table.sort(list, function(a, b) return a.d < b.d end)

        local want = {}
        for i = 1, math.min(#list, MAX_LIGHTS) do want[list[i].key] = list[i] end

        for key, cell in pairs(cells) do
            if not want[key] then
                if cell.part then cell.part:Destroy() end
                cells[key] = nil
            end
        end

        local created = 0
        local now = os.clock()
        for key, info in pairs(want) do
            local cell = cells[key]
            if cell and cell.d then cell.d = info.d end
            if (not cell or (cell.empty and now >= cell.retryAt)) and created < 6 then
                local hit = Workspace:Raycast(Vector3.new(info.x, origin.Y + 4, info.z), Vector3.new(0, -120, 0), rayParams)
                if hit then
                    created = created + 1
                    local part = Instance.new("Part")
                    part.Name = "NightLight"
                    part.Anchored = true
                    part.CanCollide = false
                    part.CanQuery = false
                    part.CanTouch = false
                    part.CastShadow = false
                    part.Transparency = 1
                    part.Size = Vector3.new(1, 1, 1)
                    part.Position = hit.Position + Vector3.new(0, 8, 0)
                    part.Parent = getFolder()
                    local light = Instance.new("PointLight")
                    light.Range = LIGHT_RANGE
                    light.Brightness = 0
                    light.Color = LIGHT_COLOR
                    light.Shadows = false
                    light.Parent = part
                    cells[key] = { part = part, light = light, d = info.d }
                else
                    cells[key] = { empty = true, retryAt = now + 5 }
                end
            end
        end
    end

    local function applyBrightness(f, radius)
        local cam = Workspace.CurrentCamera
        local camPos = cam and cam.CFrame.Position
        for _, cell in pairs(cells) do
            if cell.part and cell.part.Parent then
                local fade = 1
                if camPos then
                    fade = math.clamp(((cell.part.Position - camPos).Magnitude - 4) / NEAR_CAMERA_FADE, 0, 1)
                end
                local distFactor = 0.6 + 0.4 * math.clamp(cell.d / math.max(radius, 1), 0, 1)
                cell.light.Brightness = LIGHT_BASE_BRIGHTNESS * f * fade * distFactor
            end
        end
    end

    local f, target, timer = 0, 0, 0
    RunService.Heartbeat:Connect(function(dt)
        safeStep("Свет в темноте", function()
            timer = timer + dt
            if timer >= CHECK_INTERVAL then
                timer = 0
                target = computeTarget()
                local radius = Settings.LightRadius or 0
                if target > 0 and radius > 0 then
                    local char = LocalPlayer.Character
                    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
                    if root then updateCells(root.Position, radius) end
                end
            end

            local rate = (target > f) and RISE or FALL
            f = f + math.clamp(target - f, -rate * dt, rate * dt)

            if f > 0.003 then
                applyBrightness(f, Settings.LightRadius or 350)
            elseif next(cells) ~= nil then
                clearCells() -- совсем погасло - убираем объекты
            end
        end)
    end)
end
initDarkLights()
end

-- ==========================================
-- ОПТИМИЗАЦИЯ ГРАФИКИ ПО ДИСТАНЦИИ (LOD)
-- Всё, что дальше LodDistance (по умолчанию 1300 студов) от тебя, рисуется упрощённо ("мыльная" графика):
-- простой гладкий материал, без теней, упрощённые меши, выключены частицы/огонь/лучи/лампы.
-- Когда подходишь ближе, качество возвращается; территория, от которой ты отошёл, снова упрощается.
-- ВАЖНО: сколько карты подгружается вообще, решает сама игра (потоковая загрузка на сервере) - скрипт
-- на твоей стороне не может заставить её загрузить больше. Он снижает нагрузку от того, что уже загружено.
-- Работает порциями (около 1.5 мс кадра), поэтому не просаживает FPS даже на огромной карте.
-- ==========================================
local function initLod()
    local BUDGET_SECONDS = 0.0015  -- сколько времени кадра тратим на обработку объектов
    local HYSTERESIS = 100         -- запас у границы, чтобы качество не мерцало туда-сюда

    local EFFECT_CLASSES = {
        ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true, Trail = true, Beam = true,
        PointLight = true, SpotLight = true, SurfaceLight = true,
    }
    -- материалы, которые упрощать нельзя (потеряют смысл)
    local KEEP_MATERIAL = {
        [Enum.Material.Neon] = true,
        [Enum.Material.Glass] = true,
        [Enum.Material.ForceField] = true,
    }

    local items = {}                                  -- все отслеживаемые объекты (части и эффекты)
    local kinds = setmetatable({}, { __mode = "k" })  -- 1 = часть, 2 = эффект
    local owner = setmetatable({}, { __mode = "k" })  -- эффект -> часть, к которой он привязан
    local state = setmetatable({}, { __mode = "k" })  -- что мы изменили (чтобы вернуть как было)
    local lowCount = 0

    local function isExcluded(inst)
        -- персонажи (игроки и NPC) и наши объекты не трогаем
        local model = inst:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then return true end
        if inst:FindFirstAncestor("RebzyyxMarks3D") then return true end
        return false
    end

    local function consider(inst)
        if kinds[inst] then return end
        if inst:IsA("BasePart") then
            if inst:IsA("Terrain") then return end
            if isExcluded(inst) then return end
            kinds[inst] = 1
            items[#items + 1] = inst
        elseif EFFECT_CLASSES[inst.ClassName] then
            local part = inst:FindFirstAncestorWhichIsA("BasePart")
            if not part or part:IsA("Terrain") or isExcluded(inst) then return end
            kinds[inst] = 2
            owner[inst] = part
            items[#items + 1] = inst
        end
    end

    local function toLow(inst, kind)
        local rec = state[inst]
        if rec and rec.low then return end
        rec = { low = true }
        if kind == 1 then
            rec.material = inst.Material
            rec.shadow = inst.CastShadow
            rec.reflect = inst.Reflectance
            if inst:IsA("MeshPart") then rec.fidelity = inst.RenderFidelity end

            inst.CastShadow = false
            if inst.Reflectance > 0 then inst.Reflectance = 0 end
            if not KEEP_MATERIAL[inst.Material] and inst.Material ~= Enum.Material.SmoothPlastic then
                inst.Material = Enum.Material.SmoothPlastic
                rec.changedMaterial = true
            end
            if rec.fidelity ~= nil then inst.RenderFidelity = Enum.RenderFidelity.Performance end
        else
            if inst.Enabled then
                rec.enabled = true
                inst.Enabled = false
            end
        end
        state[inst] = rec
        lowCount = lowCount + 1
    end

    local function toNear(inst, kind)
        local rec = state[inst]
        if not rec or not rec.low then return end
        if kind == 1 then
            -- возвращаем только то, что всё ещё стоит в "нашем" значении (если игра сама поменяла - не трогаем)
            if inst.CastShadow == false and rec.shadow ~= nil then inst.CastShadow = rec.shadow end
            if rec.reflect and rec.reflect > 0 then inst.Reflectance = rec.reflect end
            if rec.changedMaterial and inst.Material == Enum.Material.SmoothPlastic then
                inst.Material = rec.material
            end
            if rec.fidelity ~= nil and inst.RenderFidelity == Enum.RenderFidelity.Performance then
                inst.RenderFidelity = rec.fidelity
            end
        else
            if rec.enabled and inst.Enabled == false then inst.Enabled = true end
        end
        rec.low = false
        lowCount = lowCount - 1
    end

    -- ---------- поиск объектов: порциями, чтобы не подвисать ----------
    local queue = { Workspace }
    local queueHead = 1

    Workspace.DescendantAdded:Connect(function(inst)
        pcall(consider, inst) -- новые объекты (в том числе подгруженные игрой при движении) попадают в список
    end)

    local function discoverStep(deadline)
        local n = 0
        while queueHead <= #queue do
            local node = queue[queueHead]
            queue[queueHead] = false
            queueHead = queueHead + 1
            if node and node.Parent then
                for _, child in ipairs(node:GetChildren()) do
                    pcall(consider, child)
                    -- в персонажей не заходим
                    if not (child:IsA("Model") and child:FindFirstChildOfClass("Humanoid")) and child ~= Workspace.CurrentCamera then
                        queue[#queue + 1] = child
                    end
                end
            end
            n = n + 1
            if n % 50 == 0 and os.clock() > deadline then return end
        end
        if queueHead > 50000 then -- очищаем пройденную часть очереди
            queue, queueHead = {}, 1
        end
    end

    -- ---------- основной проход ----------
    local cursor = 1
    local function currentRef()
        local cam = Workspace.CurrentCamera
        if Freecam.Active and cam then return cam.CFrame.Position end -- во фрикаме ориентируемся на камеру
        local char = LocalPlayer.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if root then return root.Position end
        return cam and cam.CFrame.Position or nil
    end

    local function processStep(deadline)
        local far = Settings.LodDistance
        local enabled = far and far > 0
        local ref = currentRef()
        if not ref then return end
        if not enabled and lowCount == 0 then return end

        local nearLimit = (far or 0) - HYSTERESIS
        local count = #items
        if count == 0 then return end

        local checked = 0
        while checked < count do
            if cursor > #items then cursor = 1 end
            local inst = items[cursor]

            if not inst or not inst.Parent then
                -- объект удалён (карта выгрузилась/разрушилась): убираем из списка
                if inst and state[inst] and state[inst].low then lowCount = lowCount - 1 end
                items[cursor] = items[#items]
                items[#items] = nil
            else
                local kind = kinds[inst]
                local part = (kind == 1) and inst or owner[inst]
                if part and part.Parent then
                    pcall(function()
                        local eff = (part.Position - ref).Magnitude - part.Size.Magnitude * 0.5
                        local rec = state[inst]
                        if enabled and eff > far then
                            if not (rec and rec.low) then toLow(inst, kind) end
                        elseif (not enabled) or eff < nearLimit then
                            if rec and rec.low then toNear(inst, kind) end
                        end
                    end)
                end
                cursor = cursor + 1
            end

            checked = checked + 1
            if checked % 40 == 0 and os.clock() > deadline then return end
        end
    end

    RunService.Heartbeat:Connect(function()
        safeStep("Оптимизация", function()
            local deadline = os.clock() + BUDGET_SECONDS
            discoverStep(os.clock() + BUDGET_SECONDS * 0.4)
            processStep(deadline)
        end)
    end)
end

initLod()

-- ==========================================
-- КРУЖКИ КУЛДАУНОВ ВНИЗУ ЭКРАНА (справа от панели предметов)
--  * фиолетовый - КД общих меток (10 сек после отправки метки юзерам);
--  * красный    - блокировка метки смерти (20 сек после смерти нельзя удалить).
-- Кольцо заполняется по мере готовности, в центре - сколько секунд осталось.
-- ==========================================
do
local function initCooldownCircles()
    destroyOldGui("RebzyyxCooldownGui")
    local gui = Instance.new("ScreenGui")
    gui.Name = "RebzyyxCooldownGui"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 8
    gui.Parent = GuiParent

    local SIZE, THICK = 40, 4

    local function makeRing(xScale, xOffset, color, duration)
        local root = Instance.new("Frame")
        root.AnchorPoint = Vector2.new(0.5, 0.5)
        root.Position = UDim2.new(xScale, xOffset, 1, -34)
        root.Size = UDim2.fromOffset(SIZE, SIZE)
        root.BackgroundColor3 = Color3.fromRGB(24, 22, 34)
        root.BackgroundTransparency = 0.35
        root.Parent = gui
        Instance.new("UICorner", root).CornerRadius = UDim.new(1, 0)

        -- тусклая дорожка кольца
        local track = Instance.new("Frame")
        -- обводка рисуется СНАРУЖИ рамки, поэтому кольцо делаем меньше на толщину обводки: тогда она
        -- целиком помещается в контейнер и не обрезается (обрезка давала "квадратики" на кольце)
        track.Size = UDim2.new(1, -2 * THICK, 1, -2 * THICK)
        track.Position = UDim2.fromOffset(THICK, THICK)
        track.BackgroundTransparency = 1
        track.Parent = root
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
        do
            local st = Instance.new("UIStroke")
            st.Color = color
            st.Thickness = THICK
            st.Transparency = 0.8
            st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            st.Parent = track
        end

        -- две половины кольца: заполнение идёт по часовой стрелке (градиент на обводке)
        local strokes, grads = {}, {}
        local function half(isLeft)
            local clip = Instance.new("Frame")
            clip.Size = UDim2.fromScale(0.5, 1)
            clip.Position = UDim2.fromScale(isLeft and 0 or 0.5, 0)
            clip.BackgroundTransparency = 1
            clip.ClipsDescendants = true
            clip.Parent = root

            local ring = Instance.new("Frame")
            ring.Size = UDim2.new(2, -2 * THICK, 1, -2 * THICK)
            ring.Position = UDim2.new(isLeft and 0 or -1, THICK, 0, THICK)
            ring.BackgroundTransparency = 1
            ring.Parent = clip
            Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)

            local st = Instance.new("UIStroke")
            st.Color = color
            st.Thickness = THICK
            st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            st.Parent = ring

            local g = Instance.new("UIGradient")
            g.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.5, 0),
                NumberSequenceKeypoint.new(0.501, 1),
                NumberSequenceKeypoint.new(1, 1),
            })
            g.Parent = st
            table.insert(strokes, st)
            return g
        end
        local leftGrad = half(true)
        local rightGrad = half(false)
        grads.left, grads.right = leftGrad, rightGrad

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = ""
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
        label.Parent = root

        return { root = root, grads = grads, strokes = strokes, label = label, duration = duration }
    end

    -- справа от панели предметов (как на видео): фиолетовый, правее него красный
    local purple = makeRing(0.685, 0, Color3.fromRGB(175, 90, 255), 10)
    local red = makeRing(0.685, 48, Color3.fromRGB(255, 70, 70), 20)

    local function setProgress(ring, p)
        local angle = math.clamp(p, 0, 1) * 360
        ring.grads.right.Rotation = math.clamp(angle, 0, 180)
        ring.grads.left.Rotation = 180 + math.clamp(angle - 180, 0, 180)
    end

    local function update(ring, endTime)
        local remaining = endTime - os.clock()
        if remaining > 0 then
            setProgress(ring, 1 - remaining / ring.duration)
            ring.label.Text = tostring(math.ceil(remaining))
            for _, st in ipairs(ring.strokes) do st.Transparency = 0 end
        else
            setProgress(ring, 1)
            ring.label.Text = ""
            for _, st in ipairs(ring.strokes) do st.Transparency = 0.55 end -- готово: кольцо тусклое
        end
    end

    RunService.RenderStepped:Connect(function()
        safeStep("Кружки КД", function()
            update(purple, CooldownState.shareEnd)
            update(red, CooldownState.deathEnd)
        end)
    end)
end
initCooldownCircles()
end

-- ==========================================
-- ХИТСАУНД: мягкий звук при попадании по игроку (работает на любом плейсе)
-- Попадание определяется общим способом: у игрока рядом с твоим прицелом упало здоровье (Humanoid),
-- сразу после твоего выстрела/клика. Звук встроен в скрипт (нужны writefile и getcustomasset).
-- ==========================================
do
local function initHitSound()
    local SoundService = game:GetService("SoundService")
    local Debris = game:GetService("Debris")

    local HIT_FILE = "RebzyyxHub_hit.ogg"
    local HIT_VOLUME = 1.3 -- громкость (поднята ещё раз, можно выставить и больше 1)
    local HIT_B64 = [[]]

    local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local function b64decode(data)
        local out = {}
        local bits, nbits = 0, 0
        for i = 1, #data do
            local v = string.find(B64, string.sub(data, i, i), 1, true)
            if v then
                bits = bits * 64 + (v - 1)
                nbits = nbits + 6
                if nbits >= 8 then
                    nbits = nbits - 8
                    out[#out + 1] = string.char(math.floor(bits / 2 ^ nbits))
                    bits = bits % 2 ^ nbits
                end
            end
        end
        return table.concat(out)
    end

    local soundId = nil
    pcall(function()
        local getAsset = getcustomasset or getsynasset
        if writefile and getAsset then
            writefile(HIT_FILE, b64decode(HIT_B64))
            soundId = getAsset(HIT_FILE)
        end
    end)
    if not soundId then
        warn("[Rebzyyx] Хитсаунд недоступен: экзекутору нужны writefile и getcustomasset")
        return
    end

    local template = Instance.new("Sound")
    template.Name = "RebzyyxHit"
    template.SoundId = soundId
    template.Volume = HIT_VOLUME
    pcall(function() game:GetService("ContentProvider"):PreloadAsync({ template }) end)

    -- момент последней "атаки" (клик мыши); триггербот тоже отмечает свои выстрелы
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            CooldownState.lastAttack = os.clock()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            CooldownState.lastAttack = os.clock()
        end
    end)

    -- глушим на 0.5 сек звуки, которые появятся на персонаже цели сразу после попадания
    local mutedUntil = setmetatable({}, { __mode = "k" })
    local hookedChars = setmetatable({}, { __mode = "k" })

    local function muteCharacterHitSounds(char)
        if not char then return end
        mutedUntil[char] = os.clock() + 0.5

        for _, snd in ipairs(char:GetDescendants()) do
            if snd:IsA("Sound") and snd.Name ~= "RebzyyxHit" and snd.Playing then
                pcall(function() snd.Volume = 0 end)
            end
        end

        if not hookedChars[char] then
            hookedChars[char] = true
            char.DescendantAdded:Connect(function(inst)
                if inst:IsA("Sound") and inst.Name ~= "RebzyyxHit" and mutedUntil[char] and os.clock() < mutedUntil[char] then
                    pcall(function() inst.Volume = 0 end)
                    task.defer(function() pcall(function() inst.Volume = 0 end) end) -- на случай если Volume ставят следующей строкой
                end
            end)
        end
    end

    local lastPlayed = 0
    local function onDamage(player)
        if not Settings.HitSound then return end
        local now = os.clock()
        -- урон должен прийти сразу после моего клика/выстрела
        if now - CooldownState.lastAttack > 0.45
            and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            return
        end

        local cam = Workspace.CurrentCamera
        local char = player.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
        local myChar = LocalPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
        if not cam or not root or not myRoot then return end

        -- целюсь ли я в этого игрока (угол до прицела) или он совсем рядом (ближний бой)
        local toTarget = root.Position - cam.CFrame.Position
        if toTarget.Magnitude < 0.1 then return end
        local angle = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(toTarget.Unit), -1, 1)))
        local dist = (root.Position - myRoot.Position).Magnitude
        if not (angle <= 14 or dist <= 15) then return end

        if now - lastPlayed < 0.04 then return end
        lastPlayed = now

        local s = template:Clone()
        s.PlaybackSpeed = 0.98 + math.random() * 0.06
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 1.5)

        -- Попытка приглушить "родной" звук попадания DECAY, чтобы он не перебивал наш.
        -- Это best-effort: приглушаем любые чужие звуки, которые начинают играть на цели в момент
        -- попадания (частый паттерн - звук удара вешают на персонажа жертвы). Поймать звук, который
        -- игра проигрывает отдельно от персонажа (например, через SoundService), так не получится -
        -- скрипт не видит код игры и не может определить, какой именно звук "её", без этого явного признака.
        muteCharacterHitSounds(char)
    end

    local lastHealth = setmetatable({}, { __mode = "k" })
    local function hookCharacter(player, char)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        lastHealth[hum] = hum.Health
        hum.HealthChanged:Connect(function(h)
            local prev = lastHealth[hum]
            lastHealth[hum] = h
            if prev and h < prev then onDamage(player) end
        end)
    end

    local function hookPlayer(player)
        if player == LocalPlayer then return end
        if player.Character then task.spawn(hookCharacter, player, player.Character) end
        player.CharacterAdded:Connect(function(char) hookCharacter(player, char) end)
    end
    for _, pl in ipairs(Players:GetPlayers()) do hookPlayer(pl) end
    Players.PlayerAdded:Connect(hookPlayer)
end
initHitSound()
end

-- ==========================================
-- TRIGGERBOT: сам стреляет, когда аимбот навёлся на игрока
-- Условия: включён TriggerBot и аимбот, аим зажат/включён, у аимбота есть цель (она видна, не за стеной),
-- и прицел (центр экрана) реально смотрит на эту цель. Выстрел - клик мыши экзекутора (mouse1click),
-- если его нет - Tool:Activate() у предмета в руках.
-- ==========================================
do
local function initTriggerBot()
    local TRIGGER_DELAY = 0.1 -- пауза между выстрелами (сек)
    local lastShot = 0

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function fire()
        local okActive, active = pcall(function() return isrbxactive == nil or isrbxactive() end)
        if okActive and active == false then return end -- окно Roblox не в фокусе: клик ушёл бы в другое окно

        CooldownState.lastAttack = os.clock() -- для хитсаунда
        if mouse1click then
            pcall(mouse1click)
            return
        end
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end

    RunService.Heartbeat:Connect(function()
        safeStep("TriggerBot", function()
            if not Settings.TriggerBot or not Settings.AimbotEnabled or not IsAiming then return end
            if Freecam.Active or IsRobloxMenuOpen then return end

            local part = AimTargetPart
            if not part or not part.Parent then return end

            local cam = Workspace.CurrentCamera
            if not cam then return end
            local now = os.clock()
            if now - lastShot < TRIGGER_DELAY then return end

            local ignore = { cam }
            if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
            rayParams.FilterDescendantsInstances = ignore

            -- луч строго вперёд от камеры (аимбот уже навёл прицел): попал в цель - стреляем
            local result = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * (Settings.MaxAimDistance + 50), rayParams)
            if not result or not result.Instance then return end
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model ~= part.Parent then return end

            lastShot = now
            fire()
        end)
    end)
end
initTriggerBot()
end

-- ==========================================
-- ESP ДЛЯ НПС (отдельная лёгкая система: подсветка + подпись с HP и дистанцией)
-- ==========================================
do
    local NpcVisual = {} -- [Model] = { hl, gui, nameLbl, distLbl }
    local NPC_ESP_RANGE = 300 -- подсветка и имя НПС показываются только ближе этой дистанции (студов)
    local NPC_ESP_HYSTERESIS = 25 -- запас у границы, чтобы не мигало

    local function createNpcVisual(model)
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 170, 60)
        hl.OutlineColor = Color3.fromRGB(255, 210, 140)
        hl.FillTransparency = 0.65
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Archivable = false
        hl.Parent = model

        local part = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        local gui = Instance.new("BillboardGui")
        gui.Name = "ESP_NPC_GUI"
        gui.Size = UDim2.new(0, 160, 0, 36)
        gui.StudsOffset = Vector3.new(0, 1.6, 0)
        gui.AlwaysOnTop = true
        gui.Archivable = false
        gui.Adornee = part
        gui.Parent = model

        local holder = Instance.new("Frame")
        holder.Size = UDim2.fromScale(1, 1)
        holder.BackgroundTransparency = 1
        holder.Parent = gui
        local layout = Instance.new("UIListLayout")
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = holder

        local function mk(order, size, color)
            local l = Instance.new("TextLabel")
            l.LayoutOrder = order
            l.Size = UDim2.new(1, 0, 0, size)
            l.BackgroundTransparency = 1
            l.TextColor3 = color
            l.TextStrokeColor3 = Color3.new(0, 0, 0)
            l.TextStrokeTransparency = 0.2
            l.Font = Enum.Font.GothamBold
            l.TextSize = size - 2
            l.Parent = holder
            return l
        end
        local nameLbl = mk(1, 18, Color3.fromRGB(255, 190, 110))
        nameLbl.Text = model.Name
        local distLbl = mk(2, 14, Color3.fromRGB(230, 230, 235))

        return { hl = hl, gui = gui, nameLbl = nameLbl, distLbl = distLbl }
    end

    local function destroyNpcVisual(v)
        pcall(function() v.hl:Destroy() end)
        pcall(function() v.gui:Destroy() end)
    end

    local function npcEspStep()
        if not Settings.NpcEnabled or not Settings.ESPEnabled then
            for model, v in pairs(NpcVisual) do
                destroyNpcVisual(v)
                NpcVisual[model] = nil
            end
            return
        end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))

        local alive = {}
        for _, model in ipairs(liveNpcList()) do
            local hum = model:FindFirstChildOfClass("Humanoid")
            local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
            if hum and part and myRoot then
                local dist = (part.Position - myRoot.Position).Magnitude
                local v = NpcVisual[model]

                -- создаём подсветку и имя только в радиусе 300 студов; уже созданные держим чуть дальше (гистерезис)
                if dist <= NPC_ESP_RANGE or (v and dist <= NPC_ESP_RANGE + NPC_ESP_HYSTERESIS) then
                    alive[model] = true
                    if not v or not v.hl.Parent then
                        if v then destroyNpcVisual(v) end
                        v = createNpcVisual(model)
                        NpcVisual[model] = v
                    end
                    v.distLbl.Text = math.floor(dist + 0.5) .. " studs | HP " .. math.ceil(hum.Health)
                end
            end
        end

        for model, v in pairs(NpcVisual) do
            if not alive[model] then
                destroyNpcVisual(v)
                NpcVisual[model] = nil
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        safeStep("ESP НПС", npcEspStep)
    end)
end

