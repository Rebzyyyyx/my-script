    local function removeMark(placeKey, markId)
        local entry = MarksData.places[placeKey]
        if not entry then return end
        for i, m in ipairs(entry.marks) do
            if m.id == markId then
                if m.shared and NetSend then
                    NetSend({ k = "unmark", id = m.id }) -- убираем метку и у остальных
                end
                table.remove(entry.marks, i)
                break
            end
        end
        if #entry.marks == 0 then
            MarksData.places[placeKey] = nil -- у плейса не осталось меток
        end
        saveMarks()
        MarksDirty = true
    end

    removeMarkFn = removeMark

    local function removeAllMarks(placeKey)
        local entry = MarksData.places[placeKey]
        if entry then
            local keep = {}
            for _, m in ipairs(entry.marks) do
                if isMarkLocked(m) then
                    keep[#keep + 1] = m -- свежую метку смерти удалять нельзя
                elseif m.shared and NetSend then
                    NetSend({ k = "unmark", id = m.id })
                end
            end
            if #keep == 0 then
                MarksData.places[placeKey] = nil
            else
                entry.marks = keep
            end
        end
        saveMarks()
        MarksDirty = true
    end

