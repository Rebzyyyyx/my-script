-- Если игра всё же удалила GUI указателей - создаём заново (как часть обычного обновления ESP)
local function ensureArrowGui()
    if ArrowGui and ArrowGui.Parent then return end
    if ArrowGui then pcall(function() ArrowGui:Destroy() end) end

    ArrowGui = Instance.new("ScreenGui")
    ArrowGui.Name = "RebzyyxArrowsGui"
    ArrowGui.ResetOnSpawn = false
    ArrowGui.IgnoreGuiInset = true
    ArrowGui.DisplayOrder = 3
    ArrowGui.Parent = GuiParent

    for k in pairs(ArrowPool) do ArrowPool[k] = nil end
end

local arrowSpread = 0 -- текущее отдаление 0..1 (сглаженное)

local function arrowsStep(dt)
    dt = dt or (1 / 60)
    ensureArrowGui()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    if not Settings.Arrows or IsRobloxMenuOpen or Freecam.Active then -- во фрикаме указатели скрыты, ESP остаётся
        for _, entry in pairs(ArrowPool) do
            entry.root.Visible = false
            entry.hpLabel.Visible = false
            entry.distLabel.Visible = false
        end
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local refPos = myRoot and myRoot.Position or cam.CFrame.Position

    -- скорость ходьбы по горизонтали (студов/сек): чем быстрее идёшь, тем дальше от центра указатели
    local speed = 0
    if myRoot then
        local v = myRoot.AssemblyLinearVelocity
        speed = Vector3.new(v.X, 0, v.Z).Magnitude
    end
    local spreadTarget = math.clamp(speed / ArrowSettings.SpeedForMaxSpread, 0, 1)
    arrowSpread = arrowSpread + (spreadTarget - arrowSpread) * math.clamp(dt * 8, 0, 1)
    local radius = ArrowSettings.Radius + ArrowSettings.SpreadExtra * arrowSpread

    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local existing = ArrowPool[p]
        if existing then
            existing.root.Visible = false -- сброс, ниже покажем нужные
            existing.hpLabel.Visible = false
            existing.distLabel.Visible = false
        end

        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local part = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 and not (Settings.TeamCheck and isTeammate(p)) then
                local dist = (part.Position - refPos).Magnitude
                if dist <= ArrowSettings.MaxDistance then
                    table.insert(list, {
                        player = p,
                        part = part,
                        hum = hum,
                        dist = dist,
                        friend = (Settings.IgnoreFriends and Cache[p]) and true or false,
                        target = TargetSet[p.UserId] ~= nil,
                        isFriend = Cache[p] and true or false, -- друг (для скрытия студов), независимо от "Игнор друзей"
                    })
                end
            end
        end
    end

    table.sort(list, function(a, b)
        if a.target ~= b.target then return a.target end -- таргеты всегда в первых
        return a.dist < b.dist
    end)

    -- "вперёд" берём только по горизонтали: наклон камеры вверх/вниз не сбивает стрелки.
    -- Если смотришь почти вертикально, берём горизонтальную часть UpVector камеры.
    local camCF = cam.CFrame
    local look = camCF.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.2 then
        local up = camCF.UpVector
        flatLook = Vector3.new(up.X, 0, up.Z)
        if look.Y > 0 then flatLook = -flatLook end
    end
    if flatLook.Magnitude < 0.001 then
        flatLook = Vector3.new(0, 0, -1)
    end
    flatLook = flatLook.Unit
    local flatRight = flatLook:Cross(Vector3.yAxis)
    local camPos = camCF.Position

    for i = 1, math.min(#list, ArrowSettings.MaxArrows) do
        local e = list[i]

        -- направление на игрока относительно того, куда ты смотришь по горизонтали:
        -- вперёд = вверх, вправо = вправо, назад = вниз
        local toTarget = e.part.Position - camPos
        local forwardAmount = toTarget:Dot(flatLook)
        local rightAmount = toTarget:Dot(flatRight)
        local dx, dy = rightAmount, -forwardAmount
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 0.001 then
            dx, dy, len = 0, -1, 1 -- игрок прямо над/под камерой
        end
        local ux, uy = dx / len, dy / len

        local crystal = getArrow(e.player)
        local isNear = e.dist <= ArrowSettings.NearDistance
        local color
        if e.target then
            color = isNear and ArrowSettings.TargetNearColor or ArrowSettings.TargetFarColor
        elseif e.friend then
            color = isNear and ArrowSettings.FriendNearColor or ArrowSettings.FriendFarColor
        else
            color = isNear and ArrowSettings.NearColor or ArrowSettings.FarColor
        end
        -- цвет обновляем только при смене, чтобы не гонять сотни полосок каждый кадр
        if crystal.color ~= color then
            crystal.color = color
            local coreColor = color:Lerp(Color3.fromRGB(255, 255, 255), 0.75)
            for _, f in ipairs(crystal.glowStripes) do f.BackgroundColor3 = color end
            for _, f in ipairs(crystal.bodyStripes) do f.BackgroundColor3 = color end
            for _, f in ipairs(crystal.coreStripes) do f.BackgroundColor3 = coreColor end
        end

        crystal.root.Position = UDim2.new(0.5, ux * radius, 0.5, uy * radius)
        crystal.root.Rotation = math.deg(math.atan2(uy, ux)) + 90 -- острый конец смотрит на игрока
        crystal.root.Visible = true

        -- HP под кристаллом (текст не поворачивается): зелёный / оранжевый / красный
        if ArrowSettings.ShowHp and e.hum then
            local maxHp = e.hum.MaxHealth > 0 and e.hum.MaxHealth or 100
            local ratio = math.clamp(e.hum.Health / maxHp, 0, 1)
            crystal.hpLabel.Text = tostring(math.ceil(e.hum.Health))
            if ratio > 0.6 then
                crystal.hpLabel.TextColor3 = ArrowSettings.HpHighColor
            elseif ratio > 0.3 then
                crystal.hpLabel.TextColor3 = ArrowSettings.HpMidColor
            else
                crystal.hpLabel.TextColor3 = ArrowSettings.HpLowColor
            end
            crystal.hpLabel.Position = UDim2.new(0.5, ux * radius, 0.5, uy * radius + ArrowSettings.Height / 2 + 3)
            crystal.hpLabel.Visible = true
        else
            crystal.hpLabel.Visible = false
        end

        -- расстояние в студах под HP (или сразу под кристаллом, если HP выключен)
        if ArrowSettings.ShowDistance and not e.isFriend then
            local hpShown = ArrowSettings.ShowHp and e.hum
            local offsetY = ArrowSettings.Height / 2 + 3 + (hpShown and (ArrowSettings.HpTextSize + 2) or 0)
            crystal.distLabel.Text = math.floor(e.dist + 0.5) .. " studs"
            if e.dist < ArrowSettings.DistCloseMax then
                -- ближе 250: моргает красным
                local on = math.floor(tick() * ArrowSettings.DistBlinkRate) % 2 == 0
                crystal.distLabel.TextColor3 = on and ArrowSettings.DistBlinkColorA or ArrowSettings.DistBlinkColorB
            elseif e.dist <= ArrowSettings.DistMidMax then
                crystal.distLabel.TextColor3 = ArrowSettings.DistMidColor -- 250-400: жёлтый
            else
                crystal.distLabel.TextColor3 = ArrowSettings.DistColor -- 400-1200: белый
            end
            crystal.distLabel.Position = UDim2.new(0.5, ux * radius, 0.5, uy * radius + offsetY)
            crystal.distLabel.Visible = true
        else
            crystal.distLabel.Visible = false
        end
    end
end

local warnedSections = {}
local function safeStep(name, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and not warnedSections[name] then
        warnedSections[name] = true
        warn("[Rebzyyx] Ошибка в блоке '" .. name .. "': " .. tostring(err))
    end
end

local function aimFovStep(deltaTime)
    -- если событие закрытия меню не пришло, флаг сам сбрасывается
    if IsRobloxMenuOpen and not GuiService.MenuIsOpen then
        IsRobloxMenuOpen = false
    end
    local targetPart, wallBlocked
    safeStep("Выбор цели", function()
        if IsAiming and isLockValid(LockedPart) then
            targetPart = LockedPart
        else
            targetPart, wallBlocked = getClosestPlayerInFOV()
            LockedPart = IsAiming and targetPart or nil
        end
    end)
    AimTargetPart = targetPart

    local crystalTarget = (targetPart and targetPart.Parent and not IsRobloxMenuOpen) and targetPart.Parent or nil
    safeStep("Кристаллы Target ESP", manageTargetSouls, crystalTarget, deltaTime)

    if Settings.ShowFOV and not IsRobloxMenuOpen then
        FOVGuiContainer.Visible = true
        loaderRotationSpeed = loaderRotationSpeed + (360 * deltaTime * 1.5)
        FOVGradient.Rotation = loaderRotationSpeed
        GlowGradient.Rotation = loaderRotationSpeed

        local targetColor
        if targetPart then
            targetColor = Color3.fromRGB(30, 255, 90)      -- цель видна
        elseif wallBlocked then
            targetColor = Color3.fromRGB(255, 150, 20)     -- цель за стеной
        else
            targetColor = Color3.fromRGB(255, 40, 40)      -- целей нет
        end
        FOVStroke.Color = FOVStroke.Color:Lerp(targetColor, math.clamp(deltaTime * 6, 0, 1))
        FOVGlow.Color = FOVGlow.Color:Lerp(targetColor, math.clamp(deltaTime * 6, 0, 1))
    else
        FOVGuiContainer.Visible = false
    end

end

local function espStep(deltaTime)
    local clock = now()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local rainbow = Color3.fromHSV((clock % 2.5) / 2.5, 1.0, 1.0)

    for p, data in pairs(ESP) do
        if p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("HumanoidRootPart") then
            if not data.gui or not data.gui.Parent or not data.hpGui or not data.hpGui.Parent then
                if not data.settingUp and clock >= (data.nextSetupTry or 0) then
                    data.settingUp = true
                    data.nextSetupTry = clock + 2 -- не чаще раза в 2 секунды
                    local char = p.Character
                    task.spawn(function()
                        setupCharacter(p, char)
                        data.settingUp = false
                    end)
                end
            end
        end

        if data.gui and data.hpGui and data.root and data.root.Parent then
            local isFriend = Cache[p]
            if not Settings.ESPEnabled then
                data.gui.Enabled = false
                if data.hpGui then data.hpGui.Enabled = false end
                if data.hl then data.hl.Enabled = false end
                continue
            end

            local teamColor = p.TeamColor and p.TeamColor.Color or Color3.new(1, 1, 1)
            -- "Игнор друзей" включён: друзья светятся зелёным (все остальные настройки ESP работают как обычно)
            local isTarget = TargetSet[p.UserId] ~= nil

            -- значок скрипта: у пользователей скрипта (по сигналам общего канала); у создателя ещё надпись Creator
            if data.badgeRow then
                local su = ScriptUsers[p.UserId]
                local isUser = su ~= nil
                -- создатель отмечается, пока он на сервере (не ждём сигнала из канала)
                local isCreatorHere = CREATOR_USER_ID ~= 0 and p.UserId == CREATOR_USER_ID
                data.badgeRow.Visible = isUser or isCreatorHere
                data.creatorLbl.Visible = isCreatorHere
                if (isUser or isCreatorHere) and ScriptAvatarAsset and data.badgeImg.Image ~= ScriptAvatarAsset then
                    data.badgeImg.Image = ScriptAvatarAsset
                    data.badgeImg.BackgroundTransparency = 1
                end
            end
            -- friendGreen = "особый цвет" (друг при Игнор друзей, либо таргет): радуга на таких не действует
            local friendGreen = ((Settings.IgnoreFriends and isFriend) or isTarget) and true or false
            local espColor = isTarget and Color3.fromRGB(255, 40, 40)
                or (friendGreen and Color3.fromRGB(40, 255, 90) or teamColor)
            local dist = 999999
            if myRoot then
                dist = (myRoot.Position - data.root.Position).Magnitude
            end

            local inRange = (dist <= Settings.MaxDistance)

            data.gui.Enabled = inRange
            data.hpGui.Enabled = inRange and (dist <= Settings.HpBarMaxDistance)

            if _G.RebzyyxGetDisplayPosition then
                local displayPos = _G.RebzyyxGetDisplayPosition(p.UserId, data.root.Position)
                data.gui.StudsOffsetWorldSpace = displayPos - data.root.Position
            elseif data.gui.StudsOffsetWorldSpace ~= Vector3.new() then
                data.gui.StudsOffsetWorldSpace = Vector3.new()
            end

            if data.hl then
                data.hl.Enabled = inRange
                if inRange then
                    if Settings.RainbowFriends and isFriend and not friendGreen then
                        data.hl.FillColor = rainbow
                        data.hl.OutlineColor = rainbow
                        data.hl.FillTransparency = 0.35
                    else
                        data.hl.FillColor = espColor
                        data.hl.OutlineColor = espColor
                        data.hl.FillTransparency = 0.45
                    end
                end
            end

            if inRange then
                if data.humanoid then
                    if clock - (data.lastHeavyUpdate or 0) > 0.2 then
                        data.lastHeavyUpdate = clock
                        if data.humanoid.DisplayDistanceType ~= Enum.HumanoidDisplayDistanceType.None then
                            data.humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                        end
                        if data.humanoid.HealthDisplayType ~= Enum.HumanoidHealthDisplayType.AlwaysOff then
                            data.humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                        end
                    end

                    if data.hpFill and data.statusLbl then
                        local hpPercent = math.clamp(data.humanoid.Health / data.humanoid.MaxHealth, 0, 1)
                        local isDead = data.humanoid.Health <= 0
                        local isLow = (hpPercent <= 0.35 and not isDead)

                        if isDead then
                            data.statusLbl.Text = "R.I.P"
                            data.statusLbl.TextColor3 = Color3.fromRGB(255, 0, 0)
                            
                            local heartCycle = (clock * 2.2) % 2
                            local isBeat = (heartCycle < 0.25) or (heartCycle > 0.35 and heartCycle < 0.6)
                            data.statusLbl.TextTransparency = isBeat and 0 or 0.8
                            data.statusLbl.Visible = true
                        elseif isLow then
                            data.statusLbl.Text = "Low HP!"
                            data.statusLbl.TextColor3 = Color3.fromRGB(255, 70, 70)
                            data.statusLbl.TextTransparency = ((math.sin(clock * 10) + 1) / 2) * 0.75
                            data.statusLbl.Visible = true
                        else
                            data.statusLbl.TextTransparency = 0
                            data.statusLbl.Visible = false
                        end

                        data.hpFill.Size = UDim2.new(1, 0, hpPercent, 0)

                        local hpGradient = data.hpFill:FindFirstChild("HpFillGradient")
                        if isDead then
                            data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                            if hpGradient then hpGradient.Enabled = false end
                        else
                            if Settings.RainbowFriends and isFriend and not friendGreen then
                                if hpGradient then
                                    hpGradient.Enabled = true
                                    hpGradient.Color = ColorSequence.new({
                                        ColorSequenceKeypoint.new(0, rainbow),
                                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 100, 255)),
                                        ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 255))
                                    })
                                end
                            else
                                if hpGradient then hpGradient.Enabled = false end
                                if isLow then
                                    data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
                                elseif hpPercent <= 0.65 then
                                    data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
                                else
                                    data.hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
                                end
                            end
                        end
                    end
                end

                if data.avatarGradient then
                    data.avatarGradient.Rotation = (clock * 200) % 360

                    if Settings.RainbowFriends and isFriend and not friendGreen then
                        data.avatarGradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, rainbow),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                            ColorSequenceKeypoint.new(1, rainbow)
                        })
                    else
                        data.avatarGradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, espColor),
                            ColorSequenceKeypoint.new(0.5, isTarget and Color3.fromRGB(255, 170, 170) or (friendGreen and Color3.fromRGB(190, 255, 210) or Color3.fromRGB(200, 100, 255))),
                            ColorSequenceKeypoint.new(1, espColor)
                        })
                    end
                end

                if clock - (data.lastDistUpdate or 0) > 0.2 then
                    data.lastDistUpdate = clock
                    local displayName = p.DisplayName
                    if isFriend and Settings.HideFriendsNames then
                        displayName = Settings.CustomFriendName
                    elseif not isFriend and Settings.HideOtherNames then
                        displayName = Settings.CustomOtherName
                    end

                    data.hexColor = colorToHex(espColor)
                    data.lbl.Text = string.format("<font color=\"%s\">%s</font>\n[%d studs]", data.hexColor or "#FFFFFF", displayName, math.floor(dist))
                end
            end
        end
    end
end

