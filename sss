}

local CRYSTAL_BASE = Vector3.new(0.7, 1, 0.7)

-- Настоящий октаэдр (две пирамиды). Пробуем EditableMesh, если не вышло - запасной куб.
local octaTemplate = nil
local octaTried = false

local function getOctaTemplate()
    if octaTried then return octaTemplate end
    octaTried = true

    local ok, meshPart = pcall(function()
        local em = AssetService:CreateEditableMesh()
        local top = em:AddVertex(Vector3.new(0, 0.5, 0))
        local bot = em:AddVertex(Vector3.new(0, -0.5, 0))
        local ring = {
            em:AddVertex(Vector3.new(0.35, 0, 0)),
            em:AddVertex(Vector3.new(0, 0, 0.35)),
            em:AddVertex(Vector3.new(-0.35, 0, 0)),
            em:AddVertex(Vector3.new(0, 0, -0.35)),
        }
        for i = 1, 4 do
            local a, b = ring[i], ring[i % 4 + 1]
            -- обе стороны граней, чтобы не зависеть от порядка обхода вершин
            em:AddTriangle(top, a, b)
            em:AddTriangle(top, b, a)
            em:AddTriangle(bot, a, b)
            em:AddTriangle(bot, b, a)
        end
        return AssetService:CreateMeshPartAsync(Content.fromObject(em))
    end)

    if ok and meshPart then
        octaTemplate = meshPart
    end
    return octaTemplate
end

local function createCrystal()
    local template = getOctaTemplate()
    local c
    if template then
        c = template:Clone()
    else
        c = Instance.new("Part")
    end
    c.Anchored = true
    c.CanCollide = false
    c.CanQuery = false
    c.CanTouch = false
    c.CastShadow = false
    c.Material = Enum.Material.Neon
    c.Color = CrystalStyle.Fill
    c.Size = CRYSTAL_BASE
    c.Transparency = 1
    return c
end

-- Кольцо кристаллов: модель + Highlight (даёт голубую кромку)
local function makeRing(name, paramsList)
    local model = Instance.new("Model")
    model.Name = name

    local hl = Instance.new("Highlight")
    hl.FillTransparency = 1
    hl.OutlineColor = CrystalStyle.Outline
    hl.OutlineTransparency = 0.1
    hl.DepthMode = CrystalStyle.HighlightDepth
    hl.Parent = model

    local ring = {
        model = model,
        items = {},
        alpha = 0,
        want = 0,
        t = 0,
        center = nil,
        char = nil,
    }

    for i, p in ipairs(paramsList) do
        local part = createCrystal()
        part.Parent = model
        ring.items[i] = { part = part, p = p }
    end

    return ring
end

-- Плавное появление/исчезновение. Когда невидимо - модель снимается из workspace
-- (иначе Highlight рисует кромку даже у прозрачных частей).
local function fadeRing(ring, dt)
    ring.alpha = ring.alpha + (ring.want - ring.alpha) * math.clamp(dt * 9, 0, 1)
    if ring.want == 0 and ring.alpha < 0.03 then
        ring.alpha = 0
    end

    if ring.alpha > 0 then
        if ring.model.Parent ~= workspace then ring.model.Parent = workspace end
        return true
    else
        if ring.model.Parent ~= nil then ring.model.Parent = nil end
        return false
    end
end

