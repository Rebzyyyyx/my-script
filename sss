-- ==========================================
-- ФРИКАМ (по умолчанию клавиша M; меняется кнопкой "Бинд фрикама" в худе)
-- Камера свободно летает и проходит сквозь стены, персонаж стоит на месте.
-- WASD - движение, E / Space - вверх, Q / Ctrl - вниз, Shift - быстрее, колесо - скорость,
-- зажатая ПКМ - поворот камеры. Повторное нажатие клавиши фрикама - выход (камера возвращается на место).
-- ==========================================
local ContextActionService = game:GetService("ContextActionService")

local FREECAM_KEY = Enum.KeyCode.Delete
local FREECAM_SINK_ACTION = "RebzyyxFreecamSink"
local FREECAM_BIND = "RebzyyxFreecam"

Freecam.Speed = 50          -- студов/сек
Freecam.FastMultiplier = 3  -- с зажатым Shift
Freecam.Sensitivity = 0.25  -- градусов на пиксель
Freecam.Pitch = 0
Freecam.Yaw = 0
Freecam.Position = Vector3.new()
Freecam.Looking = false

local function freecamStep(dt)
    local cam = Workspace.CurrentCamera
    if not cam then return end
    cam.CameraType = Enum.CameraType.Scriptable -- игровая камера могла вернуть свой тип

    if Freecam.Looking then
        local delta = UserInputService:GetMouseDelta()
        Freecam.Yaw = Freecam.Yaw - delta.X * Freecam.Sensitivity
        Freecam.Pitch = math.clamp(Freecam.Pitch - delta.Y * Freecam.Sensitivity, -89, 89)
    end

    local rot = CFrame.Angles(0, math.rad(Freecam.Yaw), 0) * CFrame.Angles(math.rad(Freecam.Pitch), 0, 0)

    local flat = Vector3.new()
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then flat = flat + Vector3.new(0, 0, -1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then flat = flat + Vector3.new(0, 0, 1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then flat = flat + Vector3.new(-1, 0, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then flat = flat + Vector3.new(1, 0, 0) end

    local vertical = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = vertical - 1 end

    local speed = Freecam.Speed
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        speed = speed * Freecam.FastMultiplier
    end

    local move = rot:VectorToWorldSpace(flat) + Vector3.new(0, vertical, 0)
    if move.Magnitude > 0 then
        Freecam.Position = Freecam.Position + move.Unit * speed * dt
    end

    -- игра перебила камеру с прошлого кадра? (диагностика для консоли)
    if (cam.CFrame.Position - Freecam.TargetCFrame.Position).Magnitude > 0.5 then
        Freecam.Overrides = Freecam.Overrides + 1
        if tick() - Freecam.LastWarn > 3 then
            Freecam.LastWarn = tick()
            warn("[Rebzyyx] Фрикам: игра перебивает камеру (раз: " .. Freecam.Overrides .. "), я возвращаю её обратно")
        end
    end

    -- камера не проверяет коллизии, поэтому свободно проходит сквозь стены
    Freecam.TargetCFrame = CFrame.new(Freecam.Position) * rot
    cam.CFrame = Freecam.TargetCFrame
end

-- Игра (Rust-подобная, со своей камерой и вьюмоделью) может возвращать камеру на место в любой момент кадра.
-- Поэтому нашу позицию возвращаем ещё и мгновенно при любой попытке её изменить, и в конце кадра.
local function freecamReassert()
    if not Freecam.Active then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    if cam.CameraType ~= Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Scriptable
    end
    if cam.CFrame ~= Freecam.TargetCFrame then
        cam.CFrame = Freecam.TargetCFrame
    end
end

local function freecamHookCamera(cam)
    for _, c in ipairs(Freecam.Conns) do c:Disconnect() end
    Freecam.Conns = {}
    if not cam then return end
    table.insert(Freecam.Conns, cam:GetPropertyChangedSignal("CFrame"):Connect(freecamReassert))
    table.insert(Freecam.Conns, cam:GetPropertyChangedSignal("CameraType"):Connect(freecamReassert))
    table.insert(Freecam.Conns, RunService.RenderStepped:Connect(freecamReassert))
    table.insert(Freecam.Conns, RunService.Heartbeat:Connect(freecamReassert))
end

local function stopFreecam()
    if not Freecam.Active then return end
    Freecam.Active = false

    pcall(function() RunService:UnbindFromRenderStep(FREECAM_BIND) end)
    pcall(function() ContextActionService:UnbindAction(FREECAM_SINK_ACTION) end)
    for _, c in ipairs(Freecam.Conns) do c:Disconnect() end
    Freecam.Conns = {}
    if Freecam.SwapConn then
        Freecam.SwapConn:Disconnect()
        Freecam.SwapConn = nil
    end

    if Freecam.Looking then
        Freecam.Looking = false
        if Freecam.SavedMouseBehavior then
            UserInputService.MouseBehavior = Freecam.SavedMouseBehavior
        end
    end

    -- возвращаем камеру и персонажа как были
    local cam = Workspace.CurrentCamera
    if cam then
        cam.CameraType = Freecam.SavedType or Enum.CameraType.Custom
        if Freecam.SavedSubject then cam.CameraSubject = Freecam.SavedSubject end
        if Freecam.SavedCFrame then cam.CFrame = Freecam.SavedCFrame end
    end
    if Freecam.FrozenRoot and Freecam.FrozenRoot.Parent then
        Freecam.FrozenRoot.Anchored = Freecam.WasAnchored or false
    end
    Freecam.FrozenRoot = nil

    showToast("Фрикам ВЫКЛ", Color3.fromRGB(200, 200, 210))
end

local function startFreecam()
    local cam = Workspace.CurrentCamera
    if not cam or Freecam.Active then return end
    Freecam.Active = true

    Freecam.SavedType = cam.CameraType
    Freecam.SavedSubject = cam.CameraSubject
    Freecam.SavedCFrame = cam.CFrame

    local rx, ry = cam.CFrame:ToOrientation()
    Freecam.Pitch = math.deg(rx)
    Freecam.Yaw = math.deg(ry)
    Freecam.Position = cam.CFrame.Position
    Freecam.TargetCFrame = cam.CFrame
    Freecam.Overrides = 0

    -- персонаж стоит на месте
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if root then
        Freecam.FrozenRoot = root
        Freecam.WasAnchored = root.Anchored
        root.AssemblyLinearVelocity = Vector3.new()
        root.Anchored = true
    end

    -- клавиши движения не должны управлять персонажем
    ContextActionService:BindActionAtPriority(FREECAM_SINK_ACTION, function()
        return Enum.ContextActionResult.Sink
    end, false, Enum.ContextActionPriority.High.Value + 100,
        Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
        Enum.KeyCode.Space, Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.LeftControl)

    pcall(function() RunService:UnbindFromRenderStep(FREECAM_BIND) end)
    RunService:BindToRenderStep(FREECAM_BIND, 1000000, freecamStep) -- как можно позже, после игровой камеры
    freecamHookCamera(cam)
    -- если игра подменит объект камеры - цепляемся к новому
    if Freecam.SwapConn then Freecam.SwapConn:Disconnect() end
    Freecam.SwapConn = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if Freecam.Active then freecamHookCamera(Workspace.CurrentCamera) end
    end)

    showToast("Фрикам ВКЛ", Color3.fromRGB(120, 220, 255))
end

