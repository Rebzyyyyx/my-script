    notifFrame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = notifFrame

    -- жидкость в лампе: тёмно-фиолетовая сверху, теплее к низу
