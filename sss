    local function collectUsers()
        local list = {}
        local myId = LocalPlayer.UserId
        local seenIds = {}

        local function add(id, player, isSelf)
            if seenIds[id] then return end
            seenIds[id] = true
            table.insert(list, {
                id = id, player = player, self = isSelf,
                creator = (CREATOR_USER_ID ~= 0 and id == CREATOR_USER_ID),
            })
        end

        add(myId, LocalPlayer, true)
        for userId, info in pairs(ScriptUsers) do
            if os.clock() - info.seen < 80 then
                local pl = Players:GetPlayerByUserId(userId)
                if pl then add(userId, pl, false) end
            end
        end
        -- создатель показывается, пока он на сервере
        if CREATOR_USER_ID ~= 0 then
            local pl = Players:GetPlayerByUserId(CREATOR_USER_ID)
            if pl then add(CREATOR_USER_ID, pl, pl == LocalPlayer) end
        end

        table.sort(list, function(a, b)
            if a.self ~= b.self then return a.self end
            if a.creator ~= b.creator then return a.creator end
            return a.player.Name:lower() < b.player.Name:lower()
        end)
        return list
    end

