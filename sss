    -- перетаскивание мышью по полю/полосе
    local function bindDrag(guiObject, handler)
        local dragging = false
        guiObject.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                -- позиция из самого события лежит в тех же координатах, что и AbsolutePosition
                -- (GetMouseLocation даёт сдвиг на высоту верхней панели Roblox - из-за этого ползунок был ниже курсора)
                handler(Vector2.new(input.Position.X, input.Position.Y))
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                handler(Vector2.new(input.Position.X, input.Position.Y))
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                if pickerDirty then
                    pickerDirty = false
                    saveMarks()
                end
            end
        end)
    end

