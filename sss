                showToast("Выбери, кому отправить мем-алерт", Color3.fromRGB(200, 200, 210))
                return
            end
            if not NetSend then
                showToast("Сеть скрипта недоступна", Color3.fromRGB(200, 200, 210))
                return
            end
            NetSend({ k = "meme", target = selectedTarget, preset = preset })
            showToast("Мем-алерт отправлен", Color3.fromRGB(190, 120, 255))
        end

        local function memeButton(y, text, preset)
            local b = Instance.new("TextButton")
            b.Position = UDim2.fromOffset(0, y)
            b.Size = UDim2.new(1, 0, 0, 30)
            b.BackgroundColor3 = Color3.fromRGB(60, 38, 100)
            b.BackgroundTransparency = 0.25
            b.Text = text
            b.TextColor3 = Color3.fromRGB(255, 255, 255)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 13
            b.Parent = memeFrame
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
            glassRim(b, 0.5)
            b.MouseButton1Click:Connect(function() sendMeme(preset) end)
        end
        memeButton(152, "Ооо пасхалко 1488", "paskhalko")
        memeButton(188, "Бедный спанч биба флешка", "spongebob")
        memeButton(224, "Омайгад Майлз", "miles")

        local hint = Instance.new("TextLabel")
        hint.Position = UDim2.new(0, 0, 1, -40)
        hint.Size = UDim2.new(1, 0, 0, 36)
        hint.BackgroundTransparency = 1
        hint.Text = "Мем-алерт увидит и услышит только выбранный игрок (если он на этом же сервере и у него тоже стоит скрипт)."
        hint.TextWrapped = true
        hint.TextColor3 = Color3.fromRGB(165, 160, 190)
        hint.Font = Enum.Font.Gotham
        hint.TextSize = 11
        hint.Parent = memeFrame
    end

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode ~= PANEL_KEY_MAIN then return end
        if not UserInputService:IsKeyDown(PANEL_KEY_MOD) then return end
        if HudKeyListening or Freecam.Listening or UserInputService:GetFocusedTextBox() then return end
        panel.Visible = not panel.Visible
    end)

    print("[Rebzyyx] Панель создателя: LeftShift+J" .. (AmICreator and " (доступна)" or " (не доступна - ты не создатель)"))
end

