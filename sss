-- ==========================================
-- ПРОВЕРКА СТЕН (цель за препятствием не выбирается)
-- ==========================================
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true

local function isVisible(targetPart)
    local cam = Workspace.CurrentCamera
    if not cam or not targetPart then return true end

    -- игнорируем камеру и всех персонажей: блокировать должны только стены/объекты мира
    local ignore = { cam }
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then
            table.insert(ignore, pl.Character)
        end
    end

    local origin = cam.CFrame.Position
    local goal = targetPart.Position

    -- почти прозрачные детали (стекло, невидимые триггеры) не считаем стеной
    for _ = 1, 6 do
        wallParams.FilterDescendantsInstances = ignore
        local result = Workspace:Raycast(origin, goal - origin, wallParams)
        if not result then
            return true
        end
        local hit = result.Instance
        if hit and hit:IsA("BasePart") and hit.Transparency >= 0.9 then
            table.insert(ignore, hit)
            origin = result.Position
        else
            return false
        end
    end
    return false
end

local function getClosestPlayerInFOV()
    local closestPart = nil
    local wallBlocked = false
    local shortestDistance = Settings.MaxAimDistance
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local centerScreenPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))

    if not myRoot then return nil end

    -- таргет-лист (СКМ) побеждает всегда: не смотрим на "кто ближе" среди остальных,
    -- игнорируем фильтр друзей, но реальные стены всё равно считаются
    local targetHit, targetDist = nil, math.huge
    local hasTargets = next(TargetSet) ~= nil

    local function evaluate(char, part, isTarget)
        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
        if not (onScreen and screenPos.Z > 0) then return end
        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - centerScreenPos).Magnitude
        if distToCenter > Settings.FOVRadius then return end

        local worldDist = (myRoot.Position - part.Position).Magnitude
        if worldDist > Settings.MaxAimDistance then return end

        local visible = (not Settings.WallCheck) or isVisible(part)

        if isTarget then
            if visible and worldDist < targetDist then
                targetDist = worldDist
                targetHit = part
            end
            return
        end

        if worldDist < shortestDistance then
            if visible then
                shortestDistance = worldDist
                closestPart = part
            else
                wallBlocked = true -- цель в FOV, но за стеной
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local isFriend = Cache[player]
            local isTarget = TargetSet[player.UserId] ~= nil
            if not isTarget and Settings.IgnoreFriends and isFriend then continue end

            local char = player.Character
            local targetPart = getTargetPart(char)
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            if targetPart and humanoid and humanoid.Health > 0 then
                if (not isTarget) and isTeammate(player) then continue end
                evaluate(char, targetPart, isTarget)
            end
        end
    end

    if Settings.NpcEnabled then
        for _, model in ipairs(liveNpcList()) do
            local targetPart = getTargetPart(model)
            if targetPart then
                evaluate(model, targetPart, false)
            end
        end
    end

    if targetHit then
        return targetHit, false
    end
    
    return closestPart, wallBlocked
end

