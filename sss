        MenuPanel.Visible = false
        PickerPanel.Visible = false
    end)
    refreshMarksMenu()

    -- ---------------- метка смерти ----------------
    -- Когда ты умираешь, в месте смерти автоматически ставится красная мигающая метка
    local MAX_DEATH_MARKS = 3 -- хранятся только последние смерти на этом плейсе

    local function placeDeathMark(char)
        if not Settings.DeathMarks then return end
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not root then return end

        local pos = root.Position
        -- опускаем метку на землю под местом смерти
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local hit = Workspace:Raycast(pos, Vector3.new(0, -30, 0), params)
        if hit then pos = hit.Position end

        local entry = getPlaceEntry(true)
        entry.name = CurrentPlaceName

        -- старые метки смерти убираем, чтобы не копились
        local deaths = {}
        for i, m in ipairs(entry.marks) do
            if m.kind == "death" then table.insert(deaths, i) end
        end
        while #deaths >= MAX_DEATH_MARKS do
            table.remove(entry.marks, deaths[1])
            table.remove(deaths, 1)
            for k = 1, #deaths do deaths[k] = deaths[k] - 1 end
        end

        table.insert(entry.marks, {
            id = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999)),
            x = pos.X, y = pos.Y, z = pos.Z,
            kind = "death",
            name = "Смерть",
            color = { 255, 40, 40 },
            creator = LocalPlayer.Name,
            t = os.time(),
        })
        saveMarks()
        MarksDirty = true
        showToast("Метка смерти поставлена", Color3.fromRGB(255, 90, 90))
    end

    local function hookDeath(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        hum.Died:Connect(function()
            placeDeathMark(char)
            if MenuPanel.Visible then refreshMarksMenu() end
        end)
    end
    LocalPlayer.CharacterAdded:Connect(hookDeath)
    if LocalPlayer.Character then
        task.spawn(hookDeath, LocalPlayer.Character)
    end

    -- ---------------- клавиша V: тап / двойной тап / удержание ----------------
    local vHeld = false
    local vToken = 0
    local vSuppress = false
    local lastTapTime = 0
    local lastMark = nil
    local MARK_DOUBLE_TAP = 0.3 -- быстрое повторное нажатие V

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode ~= MARK_KEY then return end
        if HudKeyListening or Freecam.Listening or UserInputService:GetFocusedTextBox() then return end
        if vHeld then return end

        vHeld = true
        vSuppress = false
        vToken = vToken + 1
        local token = vToken

        -- двойное нажатие: отправить только что поставленную метку пользователям скрипта
        local now = tick()
        if now - lastTapTime <= MARK_DOUBLE_TAP then
            vSuppress = true
            lastTapTime = 0
            shareMark(lastMark)
            return
        end

        -- удержание: открыть меню
        task.delay(MARK_HOLD_TIME, function()
            if vHeld and vToken == token and not vSuppress then
                vSuppress = true
                toggleMarksMenu()
            end
        end)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode ~= MARK_KEY then return end
        if not vHeld then return end
        vHeld = false
        if vSuppress then return end

        -- короткое нажатие: ставим свою метку (другим она не отправляется, пока не нажать V второй раз)
        lastMark = placeMark()
        lastTapTime = tick()
        if MenuPanel.Visible then refreshMarksMenu() end
    end)
end

