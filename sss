-- ==========================================
-- НАВОДКА: выполняется ПОСЛЕ стандартной камеры Roblox, иначе она перебивает наводку
-- ==========================================
-- Приоритет очень поздний: некоторые режимы игры двигают камеру своим скриптом после стандартной
-- (поэтому раньше наводка "пропадала", а ESP продолжал работать)
local AIM_PRIORITY = 5000
local lastAimStep = tick()

local function aimStep(dt)
    lastAimStep = tick()
    if Freecam.Active then return end
    local part = AimTargetPart
    if not (Settings.AimbotEnabled and IsAiming and not IsRobloxMenuOpen and part and part.Parent) then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local aimPos = part.Position
    if Settings.PredictionTime > 0 then
        local vel = part.AssemblyLinearVelocity
        -- вертикаль берём вполовину, чтобы прыжки/падения не уводили прицел
        aimPos = aimPos + Vector3.new(vel.X, vel.Y * 0.5, vel.Z) * Settings.PredictionTime
    end

    local targetCFrame = CFrame.lookAt(cam.CFrame.Position, aimPos)
    if Settings.Smoothness >= 1 then
        cam.CFrame = targetCFrame
    else
        -- не зависит от FPS
        local alpha = 1 - math.exp(-dt * (Settings.Smoothness * 25))
        cam.CFrame = cam.CFrame:Lerp(targetCFrame, alpha)
    end
end

local function bindAimbot()
    pcall(function() RunService:UnbindFromRenderStep("RebzyyxAimbot") end)
    RunService:BindToRenderStep("RebzyyxAimbot", AIM_PRIORITY, aimStep)
end
bindAimbot()

