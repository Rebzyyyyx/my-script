local function findPlayerAtCrosshair()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    local mouse = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)

    local ignore = { cam }
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore

    local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if result and result.Instance then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        local pl = model and Players:GetPlayerFromCharacter(model)
        if pl and pl ~= LocalPlayer then return pl end
    end

    local best, bestDist = nil, math.max(Settings.FOVRadius, 60)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local part = pl.Character:FindFirstChild("HumanoidRootPart") or pl.Character:FindFirstChild("Head")
            if part then
                local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                    if d < bestDist then
                        best, bestDist = pl, d
                    end
                end
            end
        end
    end
    return best
end

