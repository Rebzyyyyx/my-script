-- УВЕДОМЛЕНИЕ ПРИ ЗАПУСКЕ (ЛАВА-ЛАМПА)
-- Капли поднимаются и опускаются, вытягиваются при движении
-- и "сливаются" перемычками, когда подходят близко друг к другу
-- ==========================================
-- GUI держим в защищённом контейнере (gethui / CoreGui): игра не может удалить его при смене
-- раунда/режима (раньше в DECAY через ~15 минут пропадали аимбот-худ и FOV-круг)
local function resolveGuiParent()
    local okHui, hui = pcall(function() return gethui and gethui() end)
    if okHui and hui then return hui end

    local okCore, core = pcall(function()
        local probe = Instance.new("Folder")
        probe.Parent = game:GetService("CoreGui")
        probe:Destroy()
        return game:GetService("CoreGui")
    end)
    if okCore and core then return core end

    return LocalPlayer:WaitForChild("PlayerGui")
end
local GuiParent = resolveGuiParent()

local function destroyOldGui(name)
    for _, container in ipairs({ GuiParent, LocalPlayer:FindFirstChild("PlayerGui") }) do
        if container then
            local old = container:FindFirstChild(name)
            if old then pcall(function() old:Destroy() end) end
        end
    end
end

