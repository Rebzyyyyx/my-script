local function loadFreecamBind()
    pcall(function()
        if not (isfile and readfile and isfile(FREECAM_BIND_FILE)) then return end
        local kind, value = string.match(readfile(FREECAM_BIND_FILE), "^(%a+):(.+)$")
        if kind == "vk" and tonumber(value) then
