-- ==========================================
-- СЕТЬ ПОЛЬЗОВАТЕЛЕЙ СКРИПТА
-- Пользователи скрипта на одном сервере видят друг друга (значок в ESP, у создателя ещё "Creator")
-- и получают метки друг друга (фиолетовые, подпись "От <ник>").
-- Канал: публичный сервис ntfy.sh (бесплатный, без регистрации), тема = "rbzx-" + JobId сервера.
--  * получение: WebSocket (мгновенно); если экзекутор его не умеет - опрос раз в 8 секунд;
--  * отправка: обычный HTTP-запрос.
-- Через канал идут только твой UserId, ник, версия скрипта и координаты ТВОИХ отправленных меток.
-- Выключается кнопкой "Сеть скрипта" в худе. Состояние сети видно в списке юзеров (клавиша J).
-- ==========================================
local function initNetwork()
    local NetHttp = game:GetService("HttpService")
    local RELAY = "https://ntfy.sh/"
    local WS_RELAY = "wss://ntfy.sh/"
    local POLL_INTERVAL = 8        -- ntfy.sh ограничивает частоту запросов
    local HELLO_INTERVAL = 600     -- "я тут" раз в 10 минут (суточный лимит сообщений ограничен)
    local PEER_MARK_COOLDOWN = 10  -- от одного пользователя принимаем не чаще одной метки в 10 секунд
    local PEER_COLOR = { 170, 80, 255 } -- метки пользователей - фиолетовые

    -- ---------- аватарка скрипта (встроена в файл) ----------
    local AVATAR_B64 = [[]]
    local AVATAR_FILE = "RebzyyxHub_avatar.png"

    local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local function b64decode(data)
        local out = {}
        local bits, nbits = 0, 0
        for i = 1, #data do
            local c = string.sub(data, i, i)
            local v = string.find(B64, c, 1, true)
            if v then
                bits = bits * 64 + (v - 1)
                nbits = nbits + 6
                if nbits >= 8 then
                    nbits = nbits - 8
                    local byte = math.floor(bits / 2 ^ nbits)
                    bits = bits % 2 ^ nbits
                    out[#out + 1] = string.char(byte)
                end
            end
        end
        return table.concat(out)
    end

    pcall(function()
        local getAsset = getcustomasset or getsynasset
        if writefile and getAsset then
            writefile(AVATAR_FILE, b64decode(AVATAR_B64))
            ScriptAvatarAsset = getAsset(AVATAR_FILE)
        end
    end)

    -- ---------- создатель скрипта: ник -> UserId ----------
    task.spawn(function()
        for _ = 1, 600 do
            if CREATOR_USER_ID ~= 0 then return end
            if CREATOR_USERNAME ~= "" then
                for _, pl in ipairs(Players:GetPlayers()) do
                    if string.lower(pl.Name) == string.lower(CREATOR_USERNAME) then
                        CREATOR_USER_ID = pl.UserId
                        return
                    end
                end
            end
            task.wait(1)
        end
    end)
    if CREATOR_USER_ID == 0 and CREATOR_USERNAME ~= "" then
        task.spawn(function()
            local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(CREATOR_USERNAME) end)
            if ok and type(id) == "number" then CREATOR_USER_ID = id end
        end)
    end

    -- ---------- HTTP ----------
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request)
    if not httpRequest then
        NetStatus.text = "нет HTTP в экзекуторе"
        warn("[Rebzyyx] Сеть скрипта недоступна: экзекутор не поддерживает HTTP-запросы (request)")
        return
    end
    if game.JobId == "" then
        NetStatus.text = "нет JobId сервера"
        warn("[Rebzyyx] Сеть скрипта отключена: у сервера нет JobId (Studio/приватный тест)")
        return
    end

    local TOPIC = "rbzx-" .. game.JobId
    local myId = LocalPlayer.UserId

    local function statusOf(res)
        if type(res) ~= "table" then return "нет ответа" end
        return "HTTP " .. tostring(res.StatusCode or res.Status or "?")
    end

    local function publish(tbl)
        local ok, body = pcall(function() return NetHttp:JSONEncode(tbl) end)
        if not ok then return end
        local okReq, res = pcall(function()
            return httpRequest({
                Url = RELAY .. TOPIC,
                Method = "POST",
                Headers = { ["Content-Type"] = "text/plain" },
                Body = body,
            })
        end)
        if not okReq or type(res) ~= "table" or not (res.StatusCode == 200 or res.Success) then
            NetStatus.text = "ошибка отправки (" .. (okReq and statusOf(res) or "сбой запроса") .. ")"
        end
    end

    -- очередь отправки: не чаще одного сообщения в 0.3 сек
    local queue = {}
    NetSend = function(msg)
        if not Settings.Network then return end
        msg.u = myId
        msg.n = LocalPlayer.Name
        msg.v = SCRIPT_VERSION
        table.insert(queue, msg)
    end
    task.spawn(function()
        while true do
            task.wait(0.3)
            local msg = table.remove(queue, 1)
            if msg then publish(msg) end
        end
    end)

    -- ---------- разбор входящих сообщений ----------
    local lastPeerMark = {}   -- [UserId] = время последней принятой метки (по времени события)

    local function handleMessage(msg, eventTime)
        if type(msg) ~= "table" or type(msg.u) ~= "number" or msg.u == myId then return end
        local player = Players:GetPlayerByUserId(msg.u)
        if not player then return end -- пользователь уже не на сервере

        -- любое сообщение = "пользователь скрипта тут" (пока он на сервере)
        ScriptUsers[msg.u] = { seen = os.clock(), name = tostring(msg.n or player.Name) }

        if msg.k == "mark" and type(msg.id) == "string"
            and type(msg.x) == "number" and type(msg.y) == "number" and type(msg.z) == "number" then
            -- КД: от одного пользователя не чаще одной метки в 10 секунд
            local t = eventTime or os.time()
            local last = lastPeerMark[msg.u]
            if last and (t - last) < PEER_MARK_COOLDOWN then return end
            lastPeerMark[msg.u] = t

            local id = "p_" .. msg.u .. "_" .. msg.id
            PeerMarks[id] = {
                id = id, x = msg.x, y = msg.y, z = msg.z,
                kind = "peer",
                color = { PEER_COLOR[1], PEER_COLOR[2], PEER_COLOR[3] },
                name = "От " .. player.Name, -- без своих названий: только "От" и ник
                creator = player.Name,
                owner = msg.u,
            }
            PeerState.version = PeerState.version + 1
        elseif msg.k == "unmark" and type(msg.id) == "string" then
            local id = "p_" .. msg.u .. "_" .. msg.id
            if PeerMarks[id] then
                PeerMarks[id] = nil
                PeerState.version = PeerState.version + 1
            end
        elseif NetOnMessage then
            pcall(NetOnMessage, msg) -- прочие виды сообщений (ЧС, мем-алерты) обрабатывает панель создателя
        end
    end

    local lastId = nil
    local seenIds = {}
    local seenCount = 0
    local function processEvent(event)
        if type(event) ~= "table" or event.event ~= "message" then return end
        if type(event.id) == "string" then
            if seenIds[event.id] then return end -- WebSocket и опрос не должны дублировать сообщения
            seenIds[event.id] = true
            seenCount = seenCount + 1
            if seenCount > 3000 then seenIds, seenCount = {}, 0 end
            lastId = event.id
        end
        local okMsg, msg = pcall(function() return NetHttp:JSONDecode(tostring(event.message)) end)
        if okMsg then handleMessage(msg, tonumber(event.time)) end
    end

    -- ---------- получение: WebSocket (мгновенно) или опрос ----------
    local wsConnect = (WebSocket and WebSocket.connect) or (syn and syn.websocket and syn.websocket.connect)
    local ws, wsAlive = nil, false

    local function openWebSocket()
        if not wsConnect then return false end
        local ok, socket = pcall(wsConnect, WS_RELAY .. TOPIC .. "/ws?since=" .. (lastId or "all"))
        if not ok or not socket then return false end
        ws, wsAlive = socket, true
        pcall(function()
            socket.OnMessage:Connect(function(text)
                local okLine, event = pcall(function() return NetHttp:JSONDecode(text) end)
                if okLine then processEvent(event) end
            end)
            socket.OnClose:Connect(function() wsAlive = false end)
        end)
        return true
    end

    local backoff = 0
    local function pollOnce()
        local ok, res = pcall(function()
            return httpRequest({
                Url = RELAY .. TOPIC .. "/json?poll=1&since=" .. (lastId or "all"),
                Method = "GET",
            })
        end)
        if ok and type(res) == "table" and (res.StatusCode == 200 or res.Success) and type(res.Body) == "string" then
            backoff = 0
            NetStatus.text = "опрос каждые " .. POLL_INTERVAL .. " с"
            for line in string.gmatch(res.Body, "[^\r\n]+") do
                local okLine, event = pcall(function() return NetHttp:JSONDecode(line) end)
                if okLine then processEvent(event) end
            end
        else
            backoff = math.min(backoff + 10, 60) -- сервис недоступен или лимит запросов: пауза
            NetStatus.text = "ошибка чтения (" .. (ok and statusOf(res) or "сбой запроса") .. ")"
        end
    end

    task.spawn(function()
        while true do
            if Settings.Network then
                if wsConnect and (not ws or not wsAlive) then
                    if openWebSocket() then
                        NetStatus.text = "WebSocket подключён (мгновенно)"
                    end
                end
                if ws and wsAlive then
                    task.wait(2)
                else
                    ws = nil
                    pollOnce()
                    task.wait(POLL_INTERVAL + backoff)
                end
            else
                NetStatus.text = "выключена"
                task.wait(2)
            end
        end
    end)

    -- ---------- "я тут": при заходе и раз в 10 минут ----------
    task.spawn(function()
        task.wait(1.5)
        while true do
            if Settings.Network then NetSend({ k = "hi" }) end
            task.wait(HELLO_INTERVAL)
        end
    end)

    -- чужие метки пропадают, когда игрок вышел
    Players.PlayerRemoving:Connect(function(pl)
        ScriptUsers[pl.UserId] = nil
        local changed = false
        for id, m in pairs(PeerMarks) do
            if m.owner == pl.UserId then
                PeerMarks[id] = nil
                changed = true
            end
        end
        if changed then PeerState.version = PeerState.version + 1 end
    end)

    -- при выключении сети убираем чужие метки и значки
    task.spawn(function()
        local wasOn = Settings.Network
        while true do
            task.wait(1)
            if wasOn and not Settings.Network then
                wasOn = false
                ScriptUsers = {}
                PeerMarks = {}
                PeerState.version = PeerState.version + 1
            elseif not wasOn and Settings.Network then
                wasOn = true
            end
        end
    end)

    print("[Rebzyyx] Сеть скрипта: канал " .. TOPIC .. (wsConnect and " (WebSocket доступен)" or " (WebSocket недоступен, опрос)"))
end

initNetwork()

