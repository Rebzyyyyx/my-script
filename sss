-- Страховка от дублей: любой ESP-объект, который не принадлежит текущим данным ESP
-- (например, копия на трупе после смерти), удаляется
local ESP_OBJECT_NAMES = { ESP_HL = true, ESP_GUI = true, ESP_HP_GUI = true }

local function isRegisteredESPObject(inst)
    for _, d in pairs(ESP) do
        if d.gui == inst or d.hl == inst or d.hpGui == inst then
            return true
        end
    end
    return false
end

Workspace.DescendantAdded:Connect(function(inst)
    if ESP_OBJECT_NAMES[inst.Name] then
        task.defer(function()
            if inst.Parent and not isRegisteredESPObject(inst) then
                inst:Destroy()
            end
        end)
    end
end)

local function applyPlayer(player)
    if player == LocalPlayer then
        if player.Character then
            task.spawn(handleTrailForPlayer, player, player.Character)
        end
        player.CharacterAdded:Connect(function(char) handleTrailForPlayer(player, char) end)
        return
    end

    cleanupPlayer(player)
    ESP[player] = {}

    checkFriendshipAsync(player)

    ESP[player].charConn = player.CharacterAdded:Connect(function(char)
        task.wait(0.2)
        setupCharacter(player, char)
        handleTrailForPlayer(player, char)
    end)

    -- ВАЖНО: в отдельном потоке. setupCharacter ждёт загрузку частей персонажа (до 15 сек на игрока),
    -- и при синхронном вызове скрипт на старте "зависал" на каждом игроке по очереди:
    -- худ, аимбот и главный цикл запускались только через несколько минут.
    if player.Character then
        local char = player.Character
        task.spawn(function()
            setupCharacter(player, char)
            handleTrailForPlayer(player, char)
        end)
    end
end

