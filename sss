local ArrowGui = nil -- создаётся (и при необходимости пересоздаётся) в ensureArrowGui()

local ArrowPool = {} -- [player] = { root, glowStripes, bodyStripes, coreStripes, color }

-- Плоский тонкий кристалл (ромб) собирается из горизонтальных полосок разной ширины.
-- Весь контейнер поворачивается в сторону игрока, поэтому острый конец кристалла - это стрелка.
local CRYSTAL_STRIPES = 13

local function makeCrystalLayer(parent, width, height, transparency, zIndex)
    local stripes = {}
    local stripeHeight = height / CRYSTAL_STRIPES
    for i = 1, CRYSTAL_STRIPES do
        local yCenter = (i - 0.5) / CRYSTAL_STRIPES
        local t = 1 - math.abs(2 * yCenter - 1) -- 0 на концах, 1 посередине
        local w = math.max(1.5, width * t)

        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0)
        f.Size = UDim2.fromOffset(w, stripeHeight + 1) -- +1px, чтобы между полосками не было щелей
        f.Position = UDim2.new(0.5, 0, 0.5, (i - 1) * stripeHeight - height / 2)
        f.BackgroundTransparency = transparency
        f.BorderSizePixel = 0
        f.ZIndex = zIndex
        f.Parent = parent
        stripes[i] = f
    end
    return stripes
end

local function getArrow(player)
    local entry = ArrowPool[player]
    if entry and entry.root.Parent then return entry end

    local W, H = ArrowSettings.Width, ArrowSettings.Height

    local root = Instance.new("Frame")
    root.Name = "Crystal"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromOffset(W, H)
    root.Visible = false
    root.Parent = ArrowGui

    local hpLabel = Instance.new("TextLabel")
    hpLabel.Name = "CrystalHp"
    hpLabel.AnchorPoint = Vector2.new(0.5, 0)
    hpLabel.Size = UDim2.fromOffset(40, 14)
    hpLabel.BackgroundTransparency = 1
    hpLabel.Font = Enum.Font.GothamBold
    hpLabel.TextSize = ArrowSettings.HpTextSize
    hpLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    hpLabel.TextStrokeTransparency = 0.35
    hpLabel.Visible = false
    hpLabel.Parent = ArrowGui

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "CrystalDist"
    distLabel.AnchorPoint = Vector2.new(0.5, 0)
    distLabel.Size = UDim2.fromOffset(60, 12)
    distLabel.BackgroundTransparency = 1
    distLabel.Font = Enum.Font.GothamMedium
    distLabel.TextSize = ArrowSettings.DistTextSize
    distLabel.TextColor3 = ArrowSettings.DistColor
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.TextStrokeTransparency = 0.35
    distLabel.Visible = false
    distLabel.Parent = ArrowGui

    entry = {
        root = root,
        hpLabel = hpLabel,
        distLabel = distLabel,
        glowStripes = makeCrystalLayer(root, W * 2.4, H * 1.15, 0.86, 1), -- мягкое свечение
        bodyStripes = makeCrystalLayer(root, W, H, 0.05, 2),              -- тело кристалла
        coreStripes = makeCrystalLayer(root, W * 0.4, H * 0.62, 0.35, 3), -- светлая сердцевина
        color = nil,
    }
    ArrowPool[player] = entry
    return entry
end

