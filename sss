            Freecam.BindVk = tonumber(value)
        elseif kind == "key" then
            local ok, keyCode = pcall(function() return Enum.KeyCode[value] end)
            if ok and keyCode then
                Freecam.BindKind = "key"
                Freecam.BindKey = keyCode
            end
        end
    end)
