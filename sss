-- ==========================================
-- НОЧНОЕ ЗРЕНИЕ
-- Когда вокруг персонажа темно (замкнутое помещение / ночь и рядом нет света), яркость плавно
-- повышается, чтобы нормально видеть в тёмных местах. Когда светлеет - плавно возвращается.
-- Скрипт не может измерить свет "по пикселям", поэтому тьма определяется по признакам:
--   * над тобой потолок и/или вокруг (в радиусе 5 студов) стены = помещение/пещера;
--   * ночное время суток (Lighting.ClockTime);
--   * рядом нет включённых источников света (лампы, фонари).
-- ==========================================
local function initNightVision()
    local Lighting = game:GetService("Lighting")

    local NV_RADIUS = 5             -- радиус проверки стен вокруг персонажа (студов)
    local NV_CHECK_INTERVAL = 0.2   -- как часто проверять темноту (сек)
    local NV_RISE = 1.2             -- скорость включения (1 / сек) - около секунды плавного перехода
    local NV_FALL = 0.7             -- скорость выключения
    local NV_AT_NIGHT = true        -- считать тёмным и ночное время на улице
    local NV_AMBIENT = Color3.fromRGB(105, 112, 130)
    local NV_EXPOSURE = 0.9         -- добавка к экспозиции
    local NV_LIGHT_SEARCH = 45      -- где искать включённые лампы рядом (студов)

    -- эффект яркости (мягкий подъём тёмных участков)
    local old = Lighting:FindFirstChild("RebzyyxNightVision")
    if old then old:Destroy() end
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "RebzyyxNightVision"
    cc.Brightness = 0
    cc.Contrast = 0
    cc.Enabled = false
    cc.Parent = Lighting

    -- Запоминаем "родные" значения освещения игры. Если игра сама их меняет (смена дня и ночи),
    -- подхватываем её значения, а не затираем их.
    local base = {
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        Exposure = Lighting.ExposureCompensation,
    }
    local written = {}
    local function track(prop, key)
        Lighting:GetPropertyChangedSignal(prop):Connect(function()
            if written[key] == nil or Lighting[prop] ~= written[key] then
                base[key] = Lighting[prop]
            end
        end)
    end
    track("Ambient", "Ambient")
    track("OutdoorAmbient", "OutdoorAmbient")
    track("ExposureCompensation", "Exposure")

    local function lift(baseColor, target, f)
        -- поднимаем цвет к целевому только если он темнее (никогда не затемняем)
        return Color3.new(
            baseColor.R + math.max(0, target.R - baseColor.R) * f,
            baseColor.G + math.max(0, target.G - baseColor.G) * f,
            baseColor.B + math.max(0, target.B - baseColor.B) * f
        )
    end

    local active = false
    local function applyNightVision(f)
        if f > 0.003 then
            active = true
            local amb = lift(base.Ambient, NV_AMBIENT, f)
            local outdoor = lift(base.OutdoorAmbient, NV_AMBIENT, f)
            local exposure = base.Exposure + NV_EXPOSURE * f
            written.Ambient, written.OutdoorAmbient, written.Exposure = amb, outdoor, exposure
            Lighting.Ambient = amb
            Lighting.OutdoorAmbient = outdoor
            Lighting.ExposureCompensation = exposure
            cc.Brightness = 0.06 * f
            cc.Contrast = 0.03 * f
            cc.Enabled = true
        elseif active then
            active = false
            written.Ambient, written.OutdoorAmbient, written.Exposure = base.Ambient, base.OutdoorAmbient, base.Exposure
            Lighting.Ambient = base.Ambient
            Lighting.OutdoorAmbient = base.OutdoorAmbient
            Lighting.ExposureCompensation = base.Exposure
            cc.Enabled = false
        end
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.MaxParts = 200

    local function refreshFilters(char)
        local ignore = {}
        if char then table.insert(ignore, char) end
        local cam = Workspace.CurrentCamera
        if cam then table.insert(ignore, cam) end
        local marks = Workspace:FindFirstChild("RebzyyxMarks3D") -- свет наших меток не считается освещением
        if marks then table.insert(ignore, marks) end
        rayParams.FilterDescendantsInstances = ignore
        overlapParams.FilterDescendantsInstances = ignore
    end

    local function hasNearbyLight(pos)
        local parts = Workspace:GetPartBoundsInRadius(pos, NV_LIGHT_SEARCH, overlapParams)
        for _, part in ipairs(parts) do
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Light") and child.Enabled and child.Brightness > 0.1 then
                    if (part.Position - pos).Magnitude <= child.Range + 2 then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function isEnclosed(origin)
        local up = Workspace:Raycast(origin, Vector3.new(0, 120, 0), rayParams)
        if not up then return false end -- над головой небо

        local roofDist = (up.Position - origin).Magnitude
        local blocked = 0
        for i = 0, 7 do
            local ang = i * math.pi / 4
            local dir = Vector3.new(math.cos(ang), 0, math.sin(ang)) * NV_RADIUS
            if Workspace:Raycast(origin, dir, rayParams) then
                blocked = blocked + 1
            end
        end
        -- замкнутое место: низкий потолок, либо потолок + стены рядом
        return roofDist <= 12 or blocked >= 2
    end

    local function computeTarget()
        if not Settings.NightVision then return 0 end
        local char = LocalPlayer.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return 0 end

        refreshFilters(char)
        local origin = root.Position + Vector3.new(0, 1.5, 0)

        local clock = Lighting.ClockTime
        local night = NV_AT_NIGHT and (clock >= 19 or clock < 5.5)
        local dark = night or isEnclosed(origin)
        if not dark then return 0 end

        if hasNearbyLight(root.Position) then return 0 end -- рядом горит лампа - и так светло
        return 1
    end

    local f, target, timer = 0, 0, 0
    RunService.RenderStepped:Connect(function(dt)
        safeStep("Ночное зрение", function()
            timer = timer + dt
            if timer >= NV_CHECK_INTERVAL then
                timer = 0
                target = computeTarget()
            end
            local rate = (target > f) and NV_RISE or NV_FALL
            f = f + math.clamp(target - f, -rate * dt, rate * dt)
            applyNightVision(f)
        end)
    end)
end

initNightVision()

-- ==========================================
-- ОПТИМИЗАЦИЯ ГРАФИКИ ПО ДИСТАНЦИИ (LOD)
-- Всё, что дальше LodDistance (по умолчанию 1300 студов) от тебя, рисуется упрощённо ("мыльная" графика):
-- простой гладкий материал, без теней, упрощённые меши, выключены частицы/огонь/лучи/лампы.
-- Когда подходишь ближе, качество возвращается; территория, от которой ты отошёл, снова упрощается.
-- ВАЖНО: сколько карты подгружается вообще, решает сама игра (потоковая загрузка на сервере) - скрипт
-- на твоей стороне не может заставить её загрузить больше. Он снижает нагрузку от того, что уже загружено.
-- Работает порциями (около 1.5 мс кадра), поэтому не просаживает FPS даже на огромной карте.
-- ==========================================
local function initLod()
    local BUDGET_SECONDS = 0.0015  -- сколько времени кадра тратим на обработку объектов
    local HYSTERESIS = 100         -- запас у границы, чтобы качество не мерцало туда-сюда

    local EFFECT_CLASSES = {
        ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true, Trail = true, Beam = true,
        PointLight = true, SpotLight = true, SurfaceLight = true,
    }
    -- материалы, которые упрощать нельзя (потеряют смысл)
    local KEEP_MATERIAL = {
        [Enum.Material.Neon] = true,
        [Enum.Material.Glass] = true,
        [Enum.Material.ForceField] = true,
    }

    local items = {}                                  -- все отслеживаемые объекты (части и эффекты)
    local kinds = setmetatable({}, { __mode = "k" })  -- 1 = часть, 2 = эффект
    local owner = setmetatable({}, { __mode = "k" })  -- эффект -> часть, к которой он привязан
    local state = setmetatable({}, { __mode = "k" })  -- что мы изменили (чтобы вернуть как было)
    local lowCount = 0

    local function isExcluded(inst)
        -- персонажи (игроки и NPC) и наши объекты не трогаем
        local model = inst:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then return true end
        if inst:FindFirstAncestor("RebzyyxMarks3D") then return true end
        return false
    end

    local function consider(inst)
        if kinds[inst] then return end
        if inst:IsA("BasePart") then
            if inst:IsA("Terrain") then return end
            if isExcluded(inst) then return end
            kinds[inst] = 1
            items[#items + 1] = inst
        elseif EFFECT_CLASSES[inst.ClassName] then
            local part = inst:FindFirstAncestorWhichIsA("BasePart")
            if not part or part:IsA("Terrain") or isExcluded(inst) then return end
            kinds[inst] = 2
            owner[inst] = part
            items[#items + 1] = inst
        end
    end

    local function toLow(inst, kind)
        local rec = state[inst]
        if rec and rec.low then return end
        rec = { low = true }
        if kind == 1 then
            rec.material = inst.Material
            rec.shadow = inst.CastShadow
            rec.reflect = inst.Reflectance
            if inst:IsA("MeshPart") then rec.fidelity = inst.RenderFidelity end

            inst.CastShadow = false
            if inst.Reflectance > 0 then inst.Reflectance = 0 end
            if not KEEP_MATERIAL[inst.Material] and inst.Material ~= Enum.Material.SmoothPlastic then
                inst.Material = Enum.Material.SmoothPlastic
                rec.changedMaterial = true
            end
            if rec.fidelity ~= nil then inst.RenderFidelity = Enum.RenderFidelity.Performance end
        else
            if inst.Enabled then
                rec.enabled = true
                inst.Enabled = false
            end
        end
        state[inst] = rec
        lowCount = lowCount + 1
    end

    local function toNear(inst, kind)
        local rec = state[inst]
        if not rec or not rec.low then return end
        if kind == 1 then
            -- возвращаем только то, что всё ещё стоит в "нашем" значении (если игра сама поменяла - не трогаем)
            if inst.CastShadow == false and rec.shadow ~= nil then inst.CastShadow = rec.shadow end
            if rec.reflect and rec.reflect > 0 then inst.Reflectance = rec.reflect end
            if rec.changedMaterial and inst.Material == Enum.Material.SmoothPlastic then
                inst.Material = rec.material
            end
            if rec.fidelity ~= nil and inst.RenderFidelity == Enum.RenderFidelity.Performance then
                inst.RenderFidelity = rec.fidelity
            end
        else
            if rec.enabled and inst.Enabled == false then inst.Enabled = true end
        end
        rec.low = false
        lowCount = lowCount - 1
    end

    -- ---------- поиск объектов: порциями, чтобы не подвисать ----------
    local queue = { Workspace }
    local queueHead = 1

    Workspace.DescendantAdded:Connect(function(inst)
        pcall(consider, inst) -- новые объекты (в том числе подгруженные игрой при движении) попадают в список
    end)

    local function discoverStep(deadline)
        local n = 0
        while queueHead <= #queue do
            local node = queue[queueHead]
            queue[queueHead] = false
            queueHead = queueHead + 1
            if node and node.Parent then
                for _, child in ipairs(node:GetChildren()) do
                    pcall(consider, child)
                    -- в персонажей не заходим
                    if not (child:IsA("Model") and child:FindFirstChildOfClass("Humanoid")) and child ~= Workspace.CurrentCamera then
                        queue[#queue + 1] = child
                    end
                end
            end
            n = n + 1
            if n % 50 == 0 and os.clock() > deadline then return end
        end
        if queueHead > 50000 then -- очищаем пройденную часть очереди
            queue, queueHead = {}, 1
        end
    end

    -- ---------- основной проход ----------
    local cursor = 1
    local function currentRef()
        local cam = Workspace.CurrentCamera
        if Freecam.Active and cam then return cam.CFrame.Position end -- во фрикаме ориентируемся на камеру
        local char = LocalPlayer.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if root then return root.Position end
        return cam and cam.CFrame.Position or nil
    end

    local function processStep(deadline)
        local far = Settings.LodDistance
        local enabled = far and far > 0
        local ref = currentRef()
        if not ref then return end
        if not enabled and lowCount == 0 then return end

        local nearLimit = (far or 0) - HYSTERESIS
        local count = #items
        if count == 0 then return end

        local checked = 0
        while checked < count do
            if cursor > #items then cursor = 1 end
            local inst = items[cursor]

            if not inst or not inst.Parent then
                -- объект удалён (карта выгрузилась/разрушилась): убираем из списка
                if inst and state[inst] and state[inst].low then lowCount = lowCount - 1 end
                items[cursor] = items[#items]
                items[#items] = nil
            else
                local kind = kinds[inst]
                local part = (kind == 1) and inst or owner[inst]
                if part and part.Parent then
                    pcall(function()
                        local eff = (part.Position - ref).Magnitude - part.Size.Magnitude * 0.5
                        local rec = state[inst]
                        if enabled and eff > far then
                            if not (rec and rec.low) then toLow(inst, kind) end
                        elseif (not enabled) or eff < nearLimit then
                            if rec and rec.low then toNear(inst, kind) end
                        end
                    end)
                end
                cursor = cursor + 1
            end

            checked = checked + 1
            if checked % 40 == 0 and os.clock() > deadline then return end
        end
    end

    RunService.Heartbeat:Connect(function()
        safeStep("Оптимизация", function()
            local deadline = os.clock() + BUDGET_SECONDS
            discoverStep(os.clock() + BUDGET_SECONDS * 0.4)
            processStep(deadline)
        end)
    end)
end

initLod()

-- ==========================================
-- СМЕРТЬ / РЕСПАВН: сбрасываем состояние, перепривязываем наводку, восстанавливаем указатели
-- и пишем в консоль, что стало с GUI (чтобы понять, что именно ломается после смерти)
-- ==========================================
local function logGuiState(tag)
    local function alive(inst) return inst ~= nil and inst.Parent ~= nil end
    local cam = Workspace.CurrentCamera
    print(string.format("[Rebzyyx] %s: HUD=%s, указатели=%s, камера=%s (%s)",
        tag,
        tostring(alive(ScreenGui)),
        tostring(alive(ArrowGui)),
        cam and cam.Name or "нет",
        cam and tostring(cam.CameraType) or "-"))
end

local function onLocalCharacter(char)
    stopFreecam() -- новый персонаж: выходим из фрикама, чтобы камера не осталась оторванной
    IsAiming = false
    LockedPart = nil
    AimTargetPart = nil
    IsRobloxMenuOpen = false

    bindAimbot()      -- игра могла отвязать наводку при смерти
    ensureArrowGui()  -- и/или удалить GUI указателей

    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        hum.Died:Connect(function()
            task.delay(0.5, function() logGuiState("после смерти") end)
        end)
    end
    task.delay(1.5, function() logGuiState("после респавна") end)
end

LocalPlayer.CharacterAdded:Connect(onLocalCharacter)
if LocalPlayer.Character then
    task.spawn(onLocalCharacter, LocalPlayer.Character)
end

-- сторожевой таймер худа аимбота: если игра убрала/отключила GUI - возвращаем
task.spawn(function()
    local warned = false
    while true do
        task.wait(1)
        if not ScreenGui.Parent then
            pcall(function() ScreenGui.Parent = GuiParent end)
            if not ScreenGui.Parent and not warned then
                warned = true
                warn("[Rebzyyx] GUI аимбота удалён игрой и не может быть восстановлен")
            end
        end
        if ScreenGui.Parent and not ScreenGui.Enabled then
            ScreenGui.Enabled = true
        end
    end
end)

