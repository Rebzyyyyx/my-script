local function genTargetParams(n)
    local rnd = Random.new(1337)
    local list = {}
    for i = 1, n do
        local heightT = ((i * 5) % n) / (n - 1) -- перемешиваем высоты по индексам
        list[i] = {
            phase = (i - 1) / n * math.pi * 2 + rnd:NextNumber(-0.3, 0.3),
            speed = rnd:NextNumber(1.3, 2.1),
            radius = rnd:NextNumber(1.9, 2.8),
            y = -2.2 + heightT * 4.6,
            bobSpeed = rnd:NextNumber(2, 3.5),
            scale = rnd:NextNumber(0.6, 1.0),
            spin = Vector3.new(rnd:NextNumber(1, 3), rnd:NextNumber(2, 4), rnd:NextNumber(0.5, 2)),
        }
    end
    return list
end

local TargetRing = nil

local function rebuildTargetRing(count)
    if TargetRing and TargetRing.model then
        TargetRing.model:Destroy()
    end
    TargetRing = makeRing("RebzyyxTargetCrystals", genTargetParams(count))
end

rebuildTargetRing(Settings.SoulCount)

-- targetChar - персонаж цели (или nil), dt - deltaTime кадра
local function manageTargetSouls(targetChar, dt)
    local ring = TargetRing
    if ring.count ~= Settings.SoulCount then
        rebuildTargetRing(Settings.SoulCount)
        ring = TargetRing
        ring.count = Settings.SoulCount
    end

    local char = nil
    if Settings.TargetESPEnabled then
        if targetChar then
            ring.holdChar = targetChar
            ring.holdUntil = tick() + 0.25 -- держим цель 0.25с, чтобы не мигало на краю FOV
        end
        if ring.holdChar and tick() < (ring.holdUntil or 0) then
            char = ring.holdChar
        end
    end

    local root = nil
    if char then
        root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then
            char = nil
            root = nil
        end
    end

    if char and char ~= ring.char then
        ring.center = nil
        ring.t = 0
        ring.alpha = 0
    end
    ring.char = char
    ring.want = char and 1 or 0
    if root then ring.lastRoot = root end

    if not fadeRing(ring, dt) then return end

    local rootPart = root or ring.lastRoot
    if not rootPart or not rootPart.Parent then
        ring.alpha = 0
        return
    end

    ring.t = ring.t + dt
    local pos = rootPart.Position
    ring.center = ring.center and ring.center:Lerp(pos, 1 - math.exp(-dt * 20)) or pos

    local spawnT = math.min(ring.t / 0.5, 1)
    local tr = 1 - ring.alpha * (1 - CrystalStyle.Transparency)
    local scaleMul = 0.4 + 0.6 * ring.alpha

    for _, it in ipairs(ring.items) do
        local p = it.p
        local ang = p.phase + ring.t * p.speed
        local r = p.radius * (0.5 + 0.5 * spawnT)
        local y = p.y + math.sin(ring.t * p.bobSpeed + p.phase) * 0.25
        local offset = Vector3.new(math.cos(ang) * r, y, math.sin(ang) * r)

        it.part.Size = CRYSTAL_BASE * (p.scale * scaleMul)
        it.part.CFrame = CFrame.new(ring.center + offset)
            * CFrame.Angles(ring.t * p.spin.X, ring.t * p.spin.Y, ring.t * p.spin.Z)
        it.part.Transparency = tr
    end
end

