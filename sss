-- СМЕРТЬ / РЕСПАВН: сбрасываем состояние, перепривязываем наводку, восстанавливаем указатели
-- и пишем в консоль, что стало с GUI (чтобы понять, что именно ломается после смерти)
-- ==========================================
local function logGuiState(tag)
    local function alive(inst) return inst ~= nil and inst.Parent ~= nil end
    local cam = Workspace.CurrentCamera
    print(string.format("[Rebzyyx] %s: HUD=%s, указатели=%s, камера=%s (%s)",
        tag,
        tostring(alive(ScreenGui)),
        tostring(alive(ArrowGui)),
        cam and cam.Name or "нет",
        cam and tostring(cam.CameraType) or "-"))
end

local function onLocalCharacter(char)
    stopFreecam() -- новый персонаж: выходим из фрикама, чтобы камера не осталась оторванной
    IsAiming = false
    LockedPart = nil
    AimTargetPart = nil
    IsRobloxMenuOpen = false

    bindAimbot()      -- игра могла отвязать наводку при смерти
    ensureArrowGui()  -- и/или удалить GUI указателей

    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        hum.Died:Connect(function()
            task.delay(0.5, function() logGuiState("после смерти") end)
        end)
    end
    task.delay(1.5, function() logGuiState("после респавна") end)
end

LocalPlayer.CharacterAdded:Connect(onLocalCharacter)
if LocalPlayer.Character then
    task.spawn(onLocalCharacter, LocalPlayer.Character)
end

-- сторожевой таймер худа аимбота: если игра убрала/отключила GUI - возвращаем
task.spawn(function()
    local warned = false
    while true do
        task.wait(1)
        if not ScreenGui.Parent then
            pcall(function() ScreenGui.Parent = GuiParent end)
            if not ScreenGui.Parent and not warned then
                warned = true
                warn("[Rebzyyx] GUI аимбота удалён игрой и не может быть восстановлен")
            end
        end
        if ScreenGui.Parent and not ScreenGui.Enabled then
            ScreenGui.Enabled = true
        end
    end
end)

