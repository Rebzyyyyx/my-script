    local Blacklist = {} -- [UserId] = true
    local BlacklistOffset = {} -- [UserId] = Vector3 (сдвиг ESP/аима для конкретной цели)

    local function saveBlacklist()
        pcall(function()
            if not writefile then return end
            local ids = {}
            for id in pairs(Blacklist) do table.insert(ids, id) end
            writefile(BLACKLIST_FILE, NetHttp:JSONEncode(ids))
        end)
    end

    local function loadBlacklist()
        pcall(function()
            if not (isfile and readfile and isfile(BLACKLIST_FILE)) then return end
            local ids = NetHttp:JSONDecode(readfile(BLACKLIST_FILE))
            for _, id in ipairs(ids) do
                if type(id) == "number" then Blacklist[id] = true end
            end
        end)
    end
