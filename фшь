local function createSparkEmitter(attachment)
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "RebzyyxSparkParticle"
    emitter.Texture = ParticleSettings.Texture
    emitter.Rate = ParticleSettings.Rate
    emitter.Lifetime = NumberRange.new(ParticleSettings.Lifetime * 0.6, ParticleSettings.Lifetime)
    
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, ParticleSettings.Size),
        NumberSequenceKeypoint.new(0.6, ParticleSettings.Size * 0.8),
        NumberSequenceKeypoint.new(1, 0)
    })
    
    emitter.Color = TrailColorSequence
    
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.6, 0.2),
        NumberSequenceKeypoint.new(1, 1)
    })
    
    emitter.Speed = NumberRange.new(0.5, ParticleSettings.Speed)
    emitter.SpreadAngle = ParticleSettings.SpreadAngle
    emitter.VelocitySpread = 60
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-180, 180)
    
    emitter.LightEmission = 0.4
    emitter.Orientation = Enum.ParticleOrientation.FacingCamera
    emitter.Parent = attachment
    return emitter
end

createParticlesForCharacter = function(char)
    if not char or not ParticleSettings.Enabled then return end
    
    local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    local oldAttach = root:FindFirstChild("RebzyyxSparkAttach")
    if oldAttach then oldAttach:Destroy() end

    local attach = Instance.new("Attachment")
    attach.Name = "RebzyyxSparkAttach"
    attach.Position = Vector3.new(0, -0.8, 0)
    attach.Parent = root

    createSparkEmitter(attach)
end

local function handleTrailForPlayer(player, char)
    if not ParticleSettings.Enabled or not char then return end

    if player == LocalPlayer then
        task.spawn(createParticlesForCharacter, char)
    elseif ParticleSettings.Target == "SelfAndFriends" then
        if Cache[player] then
            task.spawn(createParticlesForCharacter, char)
        else
            checkFriendship(player)
        end
    end
end

