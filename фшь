local function cleanupCharESP(pData)
    if not pData then return end
    if pData.hl then pData.hl:Destroy() end
    if pData.gui then pData.gui:Destroy() end
    if pData.hpGui then pData.hpGui:Destroy() end
    
    pData.hl = nil; pData.gui = nil; pData.lbl = nil 
    pData.root = nil; pData.humanoid = nil; pData.hpGui = nil
    pData.hpFill = nil; pData.statusLbl = nil
end

local function cleanupPlayer(player)
    if ESP[player] then
        if ESP[player].charConn then ESP[player].charConn:Disconnect() end
        cleanupCharESP(ESP[player])
        ESP[player] = nil
    end
    Cache[player] = nil
end

