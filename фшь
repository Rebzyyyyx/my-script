            if isDead then
                islandHpBarFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                hpGlint.Visible = false
            else
                hpGlint.Visible = true
                local speedInterval = isLow and 0.6 or 2.0
                glintTimer = (glintTimer + dt) % speedInterval
                local progress = glintTimer / speedInterval
                hpGlint.Position = UDim2.new(-0.4 + (progress * 1.8), 0, 0, 0)

                if isLow then
                    islandHpBarFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                elseif hpPercent <= 0.65 then
                    islandHpBarFill.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
                else
                    islandHpBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                end
            end

            if isDead then
                local heartCycle = (nowTime * 2.2) % 2
                local isBeat = (heartCycle < 0.25) or (heartCycle > 0.35 and heartCycle < 0.6)
                island.BackgroundColor3 = isBeat and Color3.fromRGB(200, 10, 10) or Color3.fromRGB(40, 0, 0)
                scaleConstraint.Scale = 1 + (((math.sin(nowTime * 4.5) + 1) / 2) * 0.035)
            elseif isLow then
                local pulseFactor = (math.sin(nowTime * 8) + 1) / 2
                island.BackgroundColor3 = Color3.fromRGB(60, 15, 20):Lerp(Color3.fromRGB(150, 20, 20), pulseFactor)
                scaleConstraint.Scale = 1 + (((math.sin(nowTime * 6) + 1) / 2) * 0.03)
            else
                scaleConstraint.Scale = 1
                island.BackgroundColor3 = Settings.DynamicIsland.Modes[currentModeIndex].Color
            end
        end

        if nowTime - lastFpsUpdate >= 1.5 then
            local currentFps = math.floor(frameCount / (nowTime - lastFpsUpdate))
            frameCount = 0
            lastFpsUpdate = nowTime

            if currentFps ~= lastFps then
                lastFps = currentFps
                fpsNumberLabel.Text = tostring(currentFps)
                fpsNumberLabel.Position = UDim2.new(0, 0, -0.6, 0)
                fpsNumberLabel.TextTransparency = 0.5
                
                TweenService:Create(fpsNumberLabel, TweenInfo.new(0.35, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 0, 0, 0),
                    TextTransparency = 0
                }):Play()
            end
        end

        local currentTextColor = GetAdaptiveColor(island.BackgroundColor3)
        timeLabel.TextColor3 = currentTextColor
        titleLabel.TextColor3 = currentTextColor
        fpsNumberLabel.TextColor3 = currentTextColor
        fpsTextLabel.TextColor3 = currentTextColor
    end)

    local tweenInfoPing = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    task.spawn(function()
        while task.wait(0.5) do
            local date = os.date("*t")
            timeLabel.Text = string.format("%02d:%02d", date.hour, date.min)

            local rawPing = 0
            pcall(function()
                rawPing = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
            end)

            local activeBars = 4
            if rawPing > 350 then activeBars = 0
            elseif rawPing > 200 then activeBars = 1
            elseif rawPing > 120 then activeBars = 2
            elseif rawPing > 60 then activeBars = 3
            end

            local adaptivePingColor = GetAdaptiveColor(island.BackgroundColor3)
            local inactiveColor = (adaptivePingColor == Color3.fromRGB(0, 0, 0)) and Color3.fromRGB(120, 120, 120) or Color3.fromRGB(255, 255, 255)
            local inactiveTrans = (adaptivePingColor == Color3.fromRGB(0, 0, 0)) and 0.4 or 0.5

            for i = 1, 4 do
                local targetColor, targetTrans
                if i <= activeBars then
                    targetColor = adaptivePingColor
                    targetTrans = 0
                else
                    targetColor = inactiveColor
                    targetTrans = inactiveTrans
                end

                TweenService:Create(pingBars[i], tweenInfoPing, {
                    BackgroundColor3 = targetColor,
                    BackgroundTransparency = targetTrans
                }):Play()
            end
        end
    end)
end

