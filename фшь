-- ЛОГИКА AIMBOT & ESP
-- ==========================================
local function getTargetPart(char)
    if not char then return nil end
    if Settings.AimPart == "Head" then
        return char:FindFirstChild("Head")
    else
        return char:FindFirstChild("HumanoidRootPart") 
            or char:FindFirstChild("Torso") 
            or char:FindFirstChild("UpperTorso")
    end
end

local function isTeammate(player)
    if not Settings.TeamCheck then return false end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end
    if LocalPlayer.TeamColor and player.TeamColor then
        return LocalPlayer.TeamColor == player.TeamColor
    end
    return false
end

local function getClosestPlayer()
    local closestPart = nil
    local shortestDistance = Settings.FOVRadius
    local centerScreenPos = getCenterScreenLocation()
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local targetPart = getTargetPart(char)
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            if targetPart and humanoid and humanoid.Health > 0 then
                if isTeammate(player) then continue end

                if myRoot then
                    local worldDist = (myRoot.Position - targetPart.Position).Magnitude
                    if worldDist > Settings.MaxAimDistance then continue end
                end

                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen and screenPos.Z > 0 then
                    local target2D = Vector2.new(screenPos.X, screenPos.Y)
                    local distToCenter = (target2D - centerScreenPos).Magnitude

                    if distToCenter <= shortestDistance then
                        shortestDistance = distToCenter
                        closestPart = targetPart
                    end
                end
            end
        end
    end
    return closestPart
end

local function cleanupCharESP(pData)
    if not pData then return end
    if pData.connections then
        for _, conn in ipairs(pData.connections) do
            if conn and conn.Connected then conn:Disconnect() end
        end
    end
    pData.connections = {}

    if pData.hl then pData.hl:Destroy() end
    if pData.gui then pData.gui:Destroy() end
    if pData.hpGui then pData.hpGui:Destroy() end
    
    pData.hl, pData.gui, pData.lbl, pData.root = nil, nil, nil, nil
    pData.hpGui, pData.hpFill, pData.hpGradient, pData.lowHpLbl = nil, nil, nil, nil
    pData.hpStroke, pData.humanoid = nil, nil
    pData.isDying = false
end

local function cleanupPlayer(player)
    if ESP[player] then
        if ESP[player].teamConn then ESP[player].teamConn:Disconnect() end
        cleanupCharESP(ESP[player])
        ESP[player] = nil
    end
    Cache[player] = nil
end

