-- ==========================================
-- РЕНДЕР СТЕППЕД ESP
-- ==========================================
local now = tick
RunService.RenderStepped:Connect(function(dt)
    local clock = now()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    local rainbow = Color3.fromHSV((clock % 2.5) / 2.5, 1.0, 1.0)

    for p, data in pairs(ESP) do
        if p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("HumanoidRootPart") then
            if not data.gui or not data.gui.Parent or not data.hpGui or not data.hpGui.Parent then
                setupCharacter(p, p.Character)
            end
        end

        if data.gui and data.hpGui and data.root and data.root.Parent then
            local isFriend = Cache[p]
            local teamColor = p.TeamColor and p.TeamColor.Color or Color3.new(1, 1, 1)

            -- Вычисляем расстояние до игрока
            local dist = 999999
            if myRoot then
                dist = (myRoot.Position - data.root.Position).Magnitude
            end

            -- Проверяем дистанцию для отображения элементов ESP (<= 1800 студсов)
            local inRange = (dist <= Settings.MaxDistance)

            data.gui.Enabled = inRange
            data.hpGui.Enabled = inRange and (dist <= Settings.HpBarMaxDistance)

            if data.hl then
                data.hl.Enabled = inRange
                if inRange then
                    if Settings.RainbowFriends and isFriend then
                        data.hl.FillColor = rainbow
                        data.hl.OutlineColor = rainbow
                        data.hl.FillTransparency = 0.35
                    else
                        data.hl.FillColor = teamColor
                        data.hl.OutlineColor = teamColor
                        data.hl.FillTransparency = 0.45
                    end
                end
            end

            if inRange then
                if data.humanoid then
                    if data.humanoid.DisplayDistanceType ~= Enum.HumanoidDisplayDistanceType.None then
                        data.humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    end
                    if data.humanoid.HealthDisplayType ~= Enum.HumanoidHealthDisplayType.AlwaysOff then
                        data.humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                    end

                    if data.hpFill and data.statusLbl then
                        local hpPercent = math.clamp(data.humanoid.Health / data.humanoid.MaxHealth, 0, 1)
                        local isDead = data.humanoid.Health <= 0
                        local isLow = (hpPercent <= 0.35 and not isDead)

                        if isDead then
                            data.statusLbl.Text = "R.I.P"
                            data.statusLbl.TextColor3 = Color3.fromRGB(255, 0, 0)
                            
                            local heartCycle = (clock * 2.2) % 2
                            local isBeat = (heartCycle < 0.25) or (heartCycle > 0.35 and heartCycle < 0.6)
                            data.statusLbl.TextTransparency = isBeat and 0 or 0.8
                            data.statusLbl.Visible = true
                        elseif isLow then
                            data.statusLbl.Text = "Low HP!"
                            data.statusLbl.TextColor3 = Color3.fromRGB(255, 70, 70)
                            data.statusLbl.TextTransparency = ((math.sin(clock * 10) + 1) / 2) * 0.75
                            data.statusLbl.Visible = true
                        else
                            data.statusLbl.TextTransparency = 0
                            data.statusLbl.Visible = false
                        end

                        data.hpFill.Size = UDim2.new(1, 0, hpPercent, 0)

                        local hpGradient = data.hpFill:FindFirstChild("HpFillGradient")
                        if isDead then
                            data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                            if hpGradient then hpGradient.Enabled = false end
                        else
                            if Settings.RainbowFriends and isFriend then
                                if hpGradient then
                                    hpGradient.Enabled = true
                                    hpGradient.Color = ColorSequence.new({
                                        ColorSequenceKeypoint.new(0, rainbow),
                                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 100, 255)),
                                        ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 255))
                                    })
                                end
                            else
                                if hpGradient then hpGradient.Enabled = false end
                                if isLow then
                                    data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
                                elseif hpPercent <= 0.65 then
                                    data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
                                else
                                    data.hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
                                end
                            end
                        end
                    end
                end

                if data.avatarGradient then
                    data.avatarGradient.Rotation = (clock * 200) % 360

                    if Settings.RainbowFriends and isFriend then
                        data.avatarGradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, rainbow),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                            ColorSequenceKeypoint.new(1, rainbow)
                        })
                    else
                        data.avatarGradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, teamColor),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 100, 255)),
                            ColorSequenceKeypoint.new(1, teamColor)
                        })
                    end
                end

                if clock - (data.lastDistUpdate or 0) > 0.05 then
                    data.lastDistUpdate = clock
                    local displayName = p.DisplayName
                    if isFriend and Settings.HideFriendsNames then
                        displayName = Settings.CustomFriendName
                    elseif not isFriend and Settings.HideOtherNames then
                        displayName = Settings.CustomOtherName
                    end

                    data.hexColor = colorToHex(teamColor)
                    data.lbl.Text = string.format("<font color=\"%s\">%s</font>\n[%d studs]", data.hexColor or "#FFFFFF", displayName, math.floor(dist))
                end
            end
        end
    end
end)
