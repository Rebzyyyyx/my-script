local function applyESP(player)
    local teamConn = player:GetPropertyChangedSignal("TeamColor"):Connect(function()
        if ESP[player] and ESP[player].hl then
            local isPlayerFriend = Cache[player]
            if not (Settings.RainbowFriends and isPlayerFriend) then
                local teamColor = getPlayerTeamColor(player)
                ESP[player].hl.FillColor = teamColor
                ESP[player].hl.OutlineColor = teamColor
            end
        end
    end)

    ESP[player] = { teamConn = teamConn, connections = {} }
    checkFriendship(player)

    player.CharacterAdded:Connect(function(char)
        setupCharacter(player, char)
    end)

    if player.Character then
        task.spawn(setupCharacter, player, player.Character)
    end
end

