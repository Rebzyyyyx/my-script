local function colorToHex(color)
    return string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
end

local createParticlesForCharacter

local function checkFriendshipAsync(player)
    if Cache[player] ~= nil then return Cache[player] end

    task.spawn(function()
        local ok, res = pcall(function()
            return LocalPlayer:IsFriendsWith(player.UserId)
        end)
        
        Cache[player] = ok and res or false

        if Cache[player] and player.Character then
            task.spawn(createParticlesForCharacter, player.Character)
        end
    end)

    return false
end

