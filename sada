-- Создание эмиттера фиолетово-черных частиц (45% фиолетовый / 55% черный) с физикой
local function setupPersonalTrail(char)
    if not Settings.EnablePersonalTrail or not char then return end

    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not root then return end

    -- Очистка прошлых элементов
    local oldAttachment = root:FindFirstChild("PersonalTrailAttachment")
    if oldAttachment then oldAttachment:Destroy() end

    -- Создаем Attachment для стабильной привязки партиклов к физике персонажа
    local attachment = Instance.new("Attachment")
    attachment.Name = "PersonalTrailAttachment"
    attachment.Parent = root

    -- Создание ParticleEmitter
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "PersonalParticleTrail"
    emitter.Texture = Settings.TrailTexture
    emitter.Rate = Settings.ParticleRate
    emitter.Lifetime = NumberRange.new(Settings.TrailLifetime * 0.8, Settings.TrailLifetime)
    
    -- Настройка физики разлета и падения
    emitter.Speed = NumberRange.new(3, 6)               -- Начальная скорость вылета частиц
    emitter.VelocitySpread = 45                          -- Угол разлета частиц во все стороны
    emitter.Acceleration = Vector3.new(0, Settings.GravityForce, 0) -- Гравитация (падение вниз)
    emitter.Drag = 1.5                                   -- Сопротивление воздуха (плавное замедление)
    
    -- Размеры частиц
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(0.2, 0.8),
        NumberSequenceKeypoint.new(0.8, 0.5),
        NumberSequenceKeypoint.new(1, 0)
    })
    
    -- Вращение частиц в воздухе
    emitter.RotSpeed = NumberRange.new(-180, 180)
    emitter.Rotation = NumberRange.new(0, 360)

    -- Настройки цвета: 45% Фиолетовый / 55% Чёрный
    local purpleColor = Color3.fromRGB(150, 0, 255) -- Яркий фиолетовый
    local blackColor  = Color3.fromRGB(10, 10, 10)   -- Насыщенный чёрный

    emitter.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, purpleColor),
        ColorSequenceKeypoint.new(0.45, purpleColor), -- 45% длины фиолетовый
        ColorSequenceKeypoint.new(0.46, blackColor),  -- Резкий/плавный переход в чёрный
        ColorSequenceKeypoint.new(1, blackColor)      -- Остальные 55% чёрный
    })

    -- Прозрачность
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.7, 0.2),
        NumberSequenceKeypoint.new(1, 1)
    })

    -- Свечение
    emitter.LightEmission = 0.4
    emitter.LightInfluence = 0.2
    
    emitter.Parent = attachment
    
    -- Принудительный импульс при появлении, чтобы частицы спавнились сразу
    emitter:Emit(15)
end
