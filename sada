-- ==========================================
-- ПОЛНЫЙ СКРИПТ: ESP + PARTICLE TRAIL SYSTEM
-- ==========================================

-- 1. НАСТРОЙКИ ЧАСТИЦ (PARTICLES)
local ParticleSettings = {
    Enabled = true,                     -- Включить/выключить частицы
    Target = "SelfAndFriends",          -- "SelfOnly" или "SelfAndFriends"
    Texture = "rbxassetid://373435404", -- Текстура Spark
    Rate = 75,                          -- Плотность спавна
    Lifetime = 1.0,                     -- Время жизни искры (сек)
    Size = 0.5,                         -- Размер искр
    Speed = 3.0,                        -- Скорость разлета
    SpreadAngle = Vector2.new(180, 180),-- Угол разлета во все стороны
    GravityForce = -1.5,                -- Падение вниз
    Drag = 0.8                          -- Сопротивление воздуха
}

-- 2. НАСТРОЙКИ ESP И ТЕГОВ
local ESPSettings = {
    Enabled = true,
    ShowNames = true,
    ShowDistance = true,
    ShowBoxes = true,
    TeamColors = true,
    RainbowOverlay = false,
    FillTransparency = 0.5,
    OutlineTransparency = 0
}

-- ГРАДИЕНТ ЦВЕТА ЧАСТИЦ: Фиолетовый -> Черный
local PurpleColor = Color3.fromRGB(150, 0, 255)
local BlackColor  = Color3.fromRGB(0, 0, 0)

local TrailColorSequence = ColorSequence.new({
    ColorSequenceKeypoint.new(0, PurpleColor),
    ColorSequenceKeypoint.new(0.45, PurpleColor),
    ColorSequenceKeypoint.new(1, BlackColor)
})

-- СЕРВИСЫ
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

-- КЭШ ДЛЯ ДРУЗЕЙ
local friendCache = {}

local function isUserFriend(player)
    if player == LocalPlayer then return false end
    if friendCache[player.UserId] ~= nil then
        return friendCache[player.UserId]
    end

    local success, isFriend = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)

    if success then
        friendCache[player.UserId] = isFriend
        return isFriend
    end

    return false
end

-- ==========================================
-- МОДУЛЬ ESP (HIGHLIGHT & BILLBOARD)
-- ==========================================
local function createESP(player)
    if player == LocalPlayer then return end

    local function applyESP(char)
        if not char then return end
        local root = char:WaitForChild("HumanoidRootPart", 10)
        local head = char:WaitForChild("Head", 10)
        if not root or not head then return end

        -- Удаление старого ESP
        if char:FindFirstChild("ESPHighlight") then char.ESPHighlight:Destroy() end
        if head:FindFirstChild("ESPNameTag") then head.ESPNameTag:Destroy() end

        if not ESPSettings.Enabled then return end

        -- Цвет команды / по умолчанию
        local mainColor = Color3.fromRGB(255, 255, 255)
        if ESPSettings.TeamColors and player.TeamColor then
            mainColor = player.TeamColor.Color
        end

        -- 1. Highlight (Контур и Заливка)
        if ESPSettings.ShowBoxes then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.Adornee = char
            highlight.FillColor = mainColor
            highlight.OutlineColor = mainColor
            highlight.FillTransparency = ESPSettings.FillTransparency
            highlight.OutlineTransparency = ESPSettings.OutlineTransparency
            highlight.Parent = char
        end

        -- 2. BillboardGui (Имя и Дистанция)
        if ESPSettings.ShowNames or ESPSettings.ShowDistance then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ESPNameTag"
            bb.Adornee = head
            bb.Size = UDim2.new(0, 200, 0, 50)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = mainColor
            txt.TextStrokeTransparency = 0
            txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            txt.Font = Enum.Font.SourceSansBold
            txt.TextSize = 14
            txt.Parent = bb

            bb.Parent = head

            -- Обновление дистанции в реальном времени
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if not char or not char:Parent() or not head:Parent() or not txt:Parent() then
                    connection:Disconnect()
                    return
                end

                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

                local textStr = player.DisplayName or player.Name
                if ESPSettings.ShowDistance and myRoot then
                    local dist = math.floor((root.Position - myRoot.Position).Magnitude)
                    textStr = string.format("%s [%d studs]", textStr, dist)
                end

                txt.Text = textStr

                -- Радужный режим (если включен)
                if ESPSettings.RainbowOverlay then
                    local hue = (tick() % 5) / 5
                    local rainbowColor = Color3.fromHSV(hue, 1, 1)
                    txt.TextColor3 = rainbowColor
                    local hl = char:FindFirstChild("ESPHighlight")
                    if hl then hl.FillColor = rainbowColor end
                end
            end)
        end
    end

    if player.Character then
        task.spawn(applyESP, player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        applyESP(char)
    end)
end

-- ==========================================
-- МОДУЛЬ ЧАСТИЦ (SPARK EMITTER)
-- ==========================================
local function createSparkEmitter(attachment)
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "VioletBlackParticle"
    emitter.Texture = ParticleSettings.Texture
    emitter.Rate = ParticleSettings.Rate
    emitter.Lifetime = NumberRange.new(ParticleSettings.Lifetime * 0.8, ParticleSettings.Lifetime)
    
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, ParticleSettings.Size),
        NumberSequenceKeypoint.new(1, 0)
    })
    
    emitter.Color = TrailColorSequence
    
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.8, 0.2),
        NumberSequenceKeypoint.new(1, 1)
    })
    
    emitter.LightEmission = 0
    emitter.LightInfluence = 0.5
    
    emitter.Speed = NumberRange.new(0, ParticleSettings.Speed)
    emitter.SpreadAngle = ParticleSettings.SpreadAngle
    emitter.VelocitySpread = 180
    emitter.Acceleration = Vector3.new(0, ParticleSettings.GravityForce, 0)
    emitter.Drag = ParticleSettings.Drag
    
    emitter.Rotation = NumberRange.new(-180, 180)
    emitter.RotSpeed = NumberRange.new(-360, 360)
    emitter.Orientation = Enum.ParticleOrientation.FacingCamera
    
    emitter.Parent = attachment
    emitter:Emit(15)
    
    return emitter
end

local function createParticlesForCharacter(char)
    if not char then return end
    
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not root then return end

    local oldAttach = root:FindFirstChild("TrailParticleAttach")
    if oldAttach then 
        oldAttach:Destroy() 
    end

    local attach = Instance.new("Attachment")
    attach.Name = "TrailParticleAttach"
    attach.Position = Vector3.new(0, -0.2, 0)
    attach.Parent = root

    createSparkEmitter(attach)
end

local function handleParticles(player)
    if not ParticleSettings.Enabled then return end

    local function checkAndApply(char)
        if not char then return end
        
        local isSelf = (player == LocalPlayer)
        local isFriend = false
        
        if not isSelf and ParticleSettings.Target == "SelfAndFriends" then
            isFriend = isUserFriend(player)
        end

        if isSelf or isFriend then
            createParticlesForCharacter(char)
        end
    end

    if player.Character then
        task.spawn(checkAndApply, player.Character)
    end
    
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        checkAndApply(char)
    end)
end

-- ==========================================
-- ИНИЦИАЛИЗАЦИЯ
-- ==========================================
local function setupPlayer(player)
    createESP(player)
    handleParticles(player)
end

for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(setupPlayer, p)
end

Players.PlayerAdded:Connect(function(p)
    task.spawn(setupPlayer, p)
end)
